    <!-- confLog() : traces de développement, silencieuses en production.
         SYNCHRONE et en PREMIER — les scripts `defer` l'appellent dès leur
         niveau racine, elle doit donc déjà exister. Traces visibles avec
         ?debug=1 dans l'URL. -->
    <script src="{{ 'conf-debug.js' | asset_url }}"></script>
    <!-- Prix dégressif par quantité (QTY_TIERS + helpers). Chargé en SYNCHRONE
         avant les scripts inline : ils utilisent window.QTY_TIERS dès le départ. -->
    <script src="{{ 'conf-pricing-tiers.js' | asset_url }}"></script>
    <script>
      /* URL de base du backend NestJS (VPS OVH depuis le 11/08/2026 ; auparavant
         Railway).
         Pilotée par le réglage de thème « API Endpoint » (settings.api_endpoint),
         modifiable dans Personnaliser > Paramètres du thème sans toucher au code —
         c'est l'équivalent d'un fichier d'environnement côté Shopify. Un vrai
         `.env` serait inutilisable ici : Liquid est rendu par les serveurs de
         Shopify, qui ne reçoivent que les fichiers poussés du thème.

         La valeur en dur ne sert que de repli si le réglage est vide ou resté sur
         le localhost par défaut — une URL codée en dur ici avait déjà provoqué
         l'envoi des devis vers une ancienne instance pendant plusieurs jours.
         La laisser vide serait pire : les appels tomberaient sur /api/… de la
         boutique Shopify, donc en 404 silencieuse. */
      {%- assign api_setting = settings.api_endpoint | default: '' -%}
      {%- if api_setting == '' or api_setting contains 'localhost' -%}
        window.API_BASE = "https://vps-c1a07d74.vps.ovh.net/api";
      {%- else -%}
        window.API_BASE = {{ api_setting | json }};
      {%- endif -%}

      /* ── PRIX UNITAIRES (définis par l'admin) ──────────────────────────────
         Source de vérité : GET /api/pricing (dashboard admin -> BDD).
         Les valeurs ci-dessous ne sont qu'un REPLI, utilisé si le backend est
         injoignable : l'affichage reste correct au lieu de tomber à 0.
         window.PRICES est renseigné dès la réponse, puis prixUnitaire() l'utilise. */
      window.PRICES = {
        sweatshirt: 60, tshirt: 29.50, tshirt_polyester: 29.50,
        /* `coins` = COINS MÉTAL, vendus SUR DEVIS -> 0 €. Un tarif ici s'affichait
           dans le tiroir du panier pour un article qu'aucune commande en ligne
           n'honore ; la valeur précédente (2,45 €) venait de l'ancienne boutique.
           `patches` = PATCHS -> 20 €, premier palier de leur grille (10 pièces,
           le minimum de commande). */
        coins: 0, drapeaux: 19.90, patches: 20.00
      };

      /** Prix unitaire TTC d'un produit (clé de window.PRICES).
          TTC pour TOUS les produits — la mention « HT » qui figurait ici (et sur
          les badges patchs/drapeaux) était fausse et contredisait le
          récapitulatif, qui totalise « Taxes incluses ». */
      window.prixUnitaire = function (key) {
        var p = window.PRICES || {};
        var v = Number(p[key]);
        return isNaN(v) ? 0 : v;
      };

      /* Prix DÉGRESSIF par quantité (window.QTY_TIERS, tierUnitPrice,
         effectiveUnitPrice, tierMinQty) : déporté dans l'asset partagé
         conf-pricing-tiers.js (chargé plus bas), pour libérer de la marge
         template et éviter la duplication avec recapitulatif.liquid. */

      /** Formate un prix à la française : 2.45 -> "2,45 €". */
      window.formatPrix = function (n) {
        return Number(n || 0).toFixed(2).replace('.', ',') + ' €';
      };

      /* Applique une réponse de /pricing et notifie l'interface.
         Extrait en fonction pour être REJOUÉ par le sondage ci-dessous : le
         premier chargement et les rafraîchissements suivent le même chemin.
         @param premier  au tout premier appel, on notifie même si les valeurs
                         égalent le repli — les écrans rendus avant la réponse
                         doivent se réafficher dans tous les cas. */
      window.appliquerPricing = function (d, premier) {
        if (!d || !d.ok || !d.prices) return false;

        /* Signature des données servant à l'affichage. Comparée à la
           précédente pour n'émettre l'événement QUE sur changement réel : un
           re-rendu du récapitulatif à chaque sondage effacerait la saisie en
           cours de l'utilisateur (quantité, tailles). */
        var signature = JSON.stringify([d.prices, d.tiers || null]);
        var change = signature !== window._pricingSignature;
        window._pricingSignature = signature;

        window.PRICES = Object.assign({}, window.PRICES, d.prices);

        /* Produits SUR DEVIS : leur prix reste 0, quoi que réponde le backend.

           Mesuré le 11/08/2026 : `/api/pricing` servait encore
           `coins: 2.45` — une ligne `price_coins` restée en base depuis la
           boutique de développement. Le tiroir du panier affichait donc
           2,45 €/u pour un coin métal chiffré à la main sur devis.

           Le backend a été corrigé pour ignorer ces lignes, mais cette garde
           reste utile : elle protège le client tant que l'instance déployée
           sert l'ancienne réponse, et rend l'affichage indépendant de l'état
           de la base. Les grilles suivent la même logique dans
           applyTiersFromBackend(). */
        ['coins'].forEach(function (k) { window.PRICES[k] = 0; });
        /* Grilles dégressives définies dans l'admin : elles REMPLACENT la
           table locale de conf-pricing-tiers.js, qui n'est plus qu'un repli
           si le backend est injoignable. Un produit absent de la réponse
           cesse d'être dégressif — on écrase donc entièrement. */
        /* Grille validée avant application : un prix nul ou négatif ne doit
           pas écraser la table de repli (voir applyTiersFromBackend). Repli
           sur l'ancien comportement si l'asset n'a pas chargé. */
        if (d.tiers && typeof d.tiers === 'object') {
          if (typeof window.applyTiersFromBackend === 'function') {
            window.applyTiersFromBackend(d.tiers);
          } else {
            window.QTY_TIERS = d.tiers;
          }
        }
        if (change || premier) {
          document.dispatchEvent(new CustomEvent('conf:prices-loaded'));
        }
        return change;
      };

      /* Charge les prix réels au plus tôt. Quand ils arrivent, on notifie
         l'interface (les écrans déjà rendus se remettent à jour). */
      window.PRICES_READY = fetch(window.API_BASE + '/pricing')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          window.appliquerPricing(d, true);
          return window.PRICES;
        })
        .catch(function () { return window.PRICES; });   // repli silencieux

      /* ── Suivi des prix en direct ────────────────────────────────────────
         L'admin change un tarif dans le dashboard : l'onglet client ouvert
         doit le refléter sans rechargement.

         Sondage et non WebSocket/SSE : le backend n'expose aucun canal
         poussé, et la réponse pèse 676 octets pour ~370 ms — une requête par
         minute est négligeable là où un canal permanent demanderait une
         nouvelle brique serveur.

         Le sondage s'arrête quand l'onglet passe en arrière-plan et se
         rattrape au retour : inutile d'interroger pour un écran que personne
         ne regarde, et l'utilisateur qui revient voit le tarif à jour. */
      (function suivrePrix() {
        var INTERVALLE = 60000;   // 1 min : l'admin change un prix rarement.
        var minuteur = null;

        function interroger() {
          if (document.hidden) return;
          fetch(window.API_BASE + '/pricing', { cache: 'no-store' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) { window.appliquerPricing(d, false); })
            .catch(function () { /* réseau coupé : on retentera au tour suivant */ });
        }

        function demarrer() {
          if (minuteur) return;
          minuteur = setInterval(interroger, INTERVALLE);
        }
        function arreter() {
          if (!minuteur) return;
          clearInterval(minuteur);
          minuteur = null;
        }

        document.addEventListener('visibilitychange', function () {
          if (document.hidden) { arreter(); return; }
          interroger();   // rattrape ce qui a changé pendant l'absence
          demarrer();
        });

        // Ne démarre qu'une fois le premier chargement acquis, pour ne pas
        // lancer deux requêtes concurrentes au démarrage.
        window.PRICES_READY.then(demarrer);
      })();

      /* Les prix arrivent APRÈS le premier rendu : on rafraîchit ce qui est
         déjà affiché (prix unitaires + total selon la quantité courante). */
      document.addEventListener('conf:prices-loaded', function () {
        /* TTC — les prix de PRICES / QTY_TIERS sont TTC pour TOUS les produits,
           textiles comme patchs et drapeaux. Ces deux badges affichaient « HT »,
           ce qui contredisait le récapitulatif (« Taxes incluses ») : le client
           voyait un prix annoncé hors taxes puis un total identique présenté
           TTC. La table de référence le dit d'ailleurs depuis le début
           (conf-pricing-tiers.js : « TTC sauf mention »). */
        /* Clé `coins` : #coins-unit-price appartient à l'écran « Coins », qui
           affiche les PATCHS (noms inversés, cf. CONF_VARIANTS). Leur tarif est
           rangé sous `coins`. Lire `patches` renvoyait le prix des coins métal,
           un autre produit. */
        var unit = document.getElementById('coins-unit-price');
        if (unit) {
          unit.innerHTML = window.formatPrix(window.prixUnitaire('patches')) +
                           ' <span class="rp-unit-ht">TTC</span>';
        }
        var flags = document.getElementById('flags-unit-price');
        if (flags) {
          flags.innerHTML = window.formatPrix(window.prixUnitaire('drapeaux')) +
                            ' <span class="rp-unit-ht">TTC</span>';
        }
        /* Supplément MANCHES : son tarif vient de PRICES.manche, il arrive donc
           avec cette réponse. Sans ce rappel, les étiquettes rendues avant le
           fetch gardaient le prix de repli (4,00 €) même après que l'admin
           l'avait changé — le badge du récap comme les trois étiquettes du
           panneau « Upload Image ». */
        if (typeof window.updateSleeveSurcharge === 'function') {
          window.updateSleeveSurcharge();
        }

        /* TEXTILES (sweat, t-shirts) : leur prix vient des grilles dégressives,
           qui changent elles aussi avec la réponse. updateSleeveSurcharge()
           appelle déjà updateTotalPrice(), mais elle peut être absente selon
           l'écran — on garantit le recalcul dans tous les cas. */
        if (typeof window.updateTotalPrice === 'function') {
          window.updateTotalPrice();
        }

        /* TIROIR DU PANIER : ses montants sont recalculés à chaque rendu par
           cartUnitPrice() (palier + supplément manches). Sans ce redessin, un
           tiroir DÉJÀ OUVERT gardait les anciens montants jusqu'à sa
           réouverture. */
        if (typeof window.renderCartDrawer === 'function') {
          window.renderCartDrawer();
        }

        // Recalcule le total avec la quantité affichée.
        var qtyEl = document.getElementById('coin-qty-input') ||
                    document.getElementById('coin-recap-qty-input');
        if (qtyEl && typeof updateCoinPrice === 'function') {
          /* Repli aligné sur le MINIMUM de commande (10), pas sur 20 : un
             repli plus élevé accordait le palier de 20 pièces à une commande
             de 10, soit 12,50 € au lieu de 20,00 € l'unité. Même défaut que
             celui corrigé dans conf-dynamic-layout.js (A5). */
          var coinMin = (typeof window.tierMinQty === 'function')
            ? (window.tierMinQty('patches') || 10) : 10;   // grille des patchs
          updateCoinPrice(parseInt(qtyEl.value, 10) || coinMin);
        }
      });

      window.ASSET_URLS = {
        visa: "{{ 'visa.svg' | asset_url }}",
        mastercard: "{{ 'mastercard.svg' | asset_url }}",
        applepay: "{{ 'applepay.svg' | asset_url }}",
        paypal: "{{ 'paypal.svg' | asset_url }}",
        patchRecto: "{{ 'patch-recto.png' | asset_url }}",
        patchVerso: "{{ 'patch-verso.png' | asset_url }}",
        patchCote: "{{ 'patch-cote.png' | asset_url }}",
        flagRecto: "{{ 'flag-recto.png' | asset_url }}",
        flagVerso: "{{ 'flag-verso.png' | asset_url }}",
        flag4anRecto: "{{ 'flag-4an-recto.png' | asset_url }}",
        flag4anVerso: "{{ 'flag-4an-verso.png' | asset_url }}",
        // Versions PORTRAIT (drapeau vertical)
        flagRectoPortrait: "{{ 'flag-recto-portrait.png' | asset_url }}",
        flagVersoPortrait: "{{ 'flag-verso-portrait.png' | asset_url }}",
        flag4anRectoPortrait: "{{ 'flag-4an-recto-portrait.png' | asset_url }}",
        flag4anVersoPortrait: "{{ 'flag-4an-verso-portrait.png' | asset_url }}",
        logoMassacre: "{{ 'logo-massacre.png' | asset_url }}",
        /* Drapeau français apposé sur les manches (bouton « Ajouter un drapeau
           FR » du panneau Upload). URL générée par `asset_url` et exposée ici :
           conf-main-inline.js la lit sans avoir à reconstruire un chemin CDN. */
        franceFlag: "{{ 'france_flag.png' | asset_url }}"
      };

      /* Dictionnaire des images DRAPEAU, une par combinaison.
         Clé   : "{anneaux}-{couleur}-{face}-{orientation}"
         Ex.   : "2an-rouge-recto-paysage"
         Fichier attendu : flag-2an-rouge-recto-paysage.png

         Finitions : 0an (sans anneaux, défaut) | 2an | 4an
         16 couleurs × 3 finitions × 2 faces × 2 orientations = 192 images.

         NOMENCLATURE À RESPECTER pour les fichiers « sans anneaux » :
             flag-0an-{couleur}-{face}-{orientation}.png
         couleur     : blanc, blanc-casse, noir, gris, gris-fonce, gris-ardoise,
                       bleu-marine, bleu-ciel, vert-fonce, rouge, rose,
                       rose-clair, orange, jaune, violet, marron
         face        : recto | verso
         orientation : paysage | portrait
         Ex. : flag-0an-rouge-recto-paysage.png
         Tant qu'une image manque, refreshFlagImages() replie sur le blanc de
         la même finition, puis sur l'image générique — rien ne casse. */
      window.FLAG_IMAGE_URLS = {
        {%- assign fl_anneaux = "0an,2an,4an" | split: "," -%}
        {%- assign fl_colors = "blanc,noir,rouge,bleu-marine" | split: "," -%}
        {%- assign fl_faces = "recto,verso" | split: "," -%}
        {%- assign fl_orients = "paysage,portrait" | split: "," -%}
        {%- for a in fl_anneaux -%}
          {%- for c in fl_colors -%}
            {%- for f in fl_faces -%}
              {%- for o in fl_orients -%}
                {%- assign fname = "flag-" | append: a | append: "-" | append: c | append: "-" | append: f | append: "-" | append: o | append: ".png" -%}
                "{{ a }}-{{ c }}-{{ f }}-{{ o }}": "{{ fname | asset_url }}",
              {%- endfor -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endfor -%}
      };

      /* Dictionnaire des images PATCH, une par (forme × couleur).
         Clé   : "{forme}-{slug}"          Ex. : "rond-rouge"
         Fichier attendu : patch-{forme}-{slug}.png
         4 formes × 16 couleurs = 64 images. asset_url renvoie TOUJOURS une URL
         (même si le fichier n'existe pas encore) : le repli réel se fait côté JS
         par onload/onerror (comme loadFirstAvailable), avec repli sur l'image
         BLANCHE patch-{forme}-blanc.png teintée en CSS. */
      window.PATCH_IMAGE_URLS = {
        {%- assign pt_shapes = "rond,carre,rectangle,blason" | split: "," -%}
        {%- assign pt_colors = "noir,blanc-casse,gris,gris-fonce,gris-ardoise,bleu-marine,bleu-ciel,vert-fonce,rose-clair,rose,rouge,orange,jaune,violet,marron,blanc" | split: "," -%}
        {%- for s in pt_shapes -%}
          {%- for c in pt_colors -%}
            {%- assign pname = "patch-" | append: s | append: "-" | append: c | append: ".png" -%}
            "{{ s }}-{{ c }}": "{{ pname | asset_url }}",
          {%- endfor -%}
        {%- endfor -%}
      };

      /* URL des 4 images BLANCHES de repli (patch-{forme}-blanc.png), teintées en
         CSS/canvas avec la couleur choisie quand la vraie image colorée n'a pas
         été fournie. Les quatre existent bien.

         Historique utile : `patch-rond-blanc.png` (500×499, 116 Ko) était présente
         sur le thème DÉPLOYÉ mais ABSENTE du dépôt local — l'IDE la signalait
         introuvable. Récupérée depuis le CDN le 2026-08-07. C'était un risque
         réel : `shopify theme push` SUPPRIME les fichiers distants qui n'existent
         pas en local, donc un push l'aurait effacée du thème en production.

         Si un linter signale à nouveau une image manquante, vérifier d'abord si
         elle répond sur le CDN
         (`/cdn/shop/t/5/assets/<nom>.png`) avant de conclure à un oubli — et la
         rapatrier dans assets/ le cas échéant. */
      window.PATCH_WHITE_URLS = {
        rond:      "{{ 'patch-rond-blanc.png'      | asset_url }}",
        carre:     "{{ 'patch-carre-blanc.png'     | asset_url }}",
        rectangle: "{{ 'patch-rectangle-blanc.png' | asset_url }}",
        blason:    "{{ 'patch-blason-blanc.png'    | asset_url }}"
      };

      // Dictionnaire de toutes les images textile (clé = "produit-couleur-vue")
      // Généré côté Liquid pour avoir les URLs CDN exactes (avec ?v=...).
      window.PRODUCT_IMAGE_URLS = {
        {%- assign tx_products = "sweatshirt,tshirt,tshirt-polyester" | split: "," -%}
        {%- assign tx_colors = "apricot,ash,atoll,black,bottle-green,brown,burgundy,chocolate,cobalt-blue,dark-grey,diva-blue,fire-red,gold,kelly-green,millennial-lilac,millennial-mint,natural,navy,navy-blue,orange,orchid-green,orchid-pink,pacific-grey,pixel-lime,radiant-purple,red,royal-blue,sand,sky,solar-yellow,sorbet,sport-grey,stone-blue,sunset-orange,swimming-pool,urban-khaki,urban-orange,urban-purple,used-black,white" | split: "," -%}
        {%- assign tx_views = "face,dos,cote" | split: "," -%}
        {%- for p in tx_products -%}
          {%- for c in tx_colors -%}
            {%- for v in tx_views -%}
              {%- assign fname = p | append: "-" | append: c | append: "-" | append: v | append: ".png" -%}
              "{{ p }}-{{ c }}-{{ v }}": "{{ fname | asset_url }}",
            {%- endfor -%}
          {%- endfor -%}
        {%- endfor -%}
      };

      window.COIN_IMAGE_URLS = {
        'patch-recto-or':     "{{ 'patch-recto-or.png'     | asset_url }}",
        'patch-recto-argent': "{{ 'patch-recto-argent.png' | asset_url }}",
        'patch-recto-nickel': "{{ 'patch-recto-nickel.png' | asset_url }}",
        'patch-recto-bronze': "{{ 'patch-recto-bronze.png' | asset_url }}",
        'patch-recto-cuivre': "{{ 'patch-recto-cuivre.png' | asset_url }}",

        'patch-verso-or':     "{{ 'patch-verso-or.png'     | asset_url }}",
        'patch-verso-argent': "{{ 'patch-verso-argent.png' | asset_url }}",
        'patch-verso-nickel': "{{ 'patch-verso-nickel.png' | asset_url }}",
        'patch-verso-bronze': "{{ 'patch-verso-bronze.png' | asset_url }}",
        'patch-verso-cuivre': "{{ 'patch-verso-cuivre.png' | asset_url }}",

        'patch-cote-or':     "{{ 'patch-cote-or.png'     | asset_url }}",
        'patch-cote-argent': "{{ 'patch-cote-argent.png' | asset_url }}",
        'patch-cote-nickel': "{{ 'patch-cote-nickel.png' | asset_url }}",
        'patch-cote-bronze': "{{ 'patch-cote-bronze.png' | asset_url }}",
        'patch-cote-cuivre': "{{ 'patch-cote-cuivre.png' | asset_url }}"
      };

      // Images couleur EXISTANTES (nommées en français). Servent de repli quand
      // l'image {produit}-{slugEN}-{vue}.png n'a pas encore été fournie.
      window.PRODUCT_IMAGE_URLS_LEGACY = {
        {%- assign lg_products = "sweatshirt,tshirt,tshirt-polyester" | split: "," -%}
        {%- assign lg_colors = "blanc-casse,bleu-ciel,bleu-marine,gris,gris-ardoise,gris-fonce,jaune,marron,noir,orange,rose,rose-clair,rouge,vert-fonce,violet" | split: "," -%}
        {%- assign lg_views = "face,dos,cote" | split: "," -%}
        {%- for p in lg_products -%}
          {%- for c in lg_colors -%}
            {%- for v in lg_views -%}
              {%- assign lname = p | append: "-" | append: c | append: "-" | append: v | append: ".png" -%}
              "{{ p }}-{{ c }}-{{ v }}": "{{ lname | asset_url }}",
            {%- endfor -%}
          {%- endfor -%}
        {%- endfor -%}
      };

      // Correspondance : nouveau slug (EN) -> ancien slug d'image (FR) le plus proche.
      // Permet aux 15 images existantes de couvrir les 40 couleurs en attendant
      // que les vraies images couleur soient fournies.
      window.COLOR_SLUG_LEGACY = {
        'black': 'noir', 'used-black': 'noir',
        'white': 'blanc-casse', 'ash': 'blanc-casse', 'natural': 'blanc-casse', 'sand': 'blanc-casse',
        'navy': 'bleu-marine', 'navy-blue': 'bleu-marine', 'cobalt-blue': 'bleu-marine',
        'royal-blue': 'bleu-marine', 'urban-purple': 'bleu-marine', 'stone-blue': 'bleu-marine',
        'diva-blue': 'bleu-marine',
        'sky': 'bleu-ciel', 'atoll': 'bleu-ciel', 'swimming-pool': 'bleu-ciel',
        'millennial-mint': 'bleu-ciel', 'millennial-lilac': 'bleu-ciel',
        'red': 'rouge', 'fire-red': 'rouge', 'burgundy': 'rouge',
        'orange': 'orange', 'urban-orange': 'orange', 'sunset-orange': 'orange', 'apricot': 'orange',
        'gold': 'jaune', 'solar-yellow': 'jaune',
