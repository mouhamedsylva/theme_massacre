       de personnalisation (détails, taille, aperçu) sont jointes à la ligne.
       Les coins n'ont pas de variant : ils passent par une demande de devis
       et sont ignorés ici. */
    function buildShopifyItems(cart) {
      var items = [], skipped = [];
      /* Réinitialisé à chaque construction : variantForItem() y consigne les
         couleurs sans variant, pour que le checkout puisse en avertir le client
         au lieu de substituer une teinte en silence (A17). */
      window.__variantColorFallbacks = [];
      cart.forEach(function (it) {
        var variantId = variantForItem(it);
        if (!variantId) { skipped.push(it); return; }

        var properties = {};
        // Visibles au checkout (utiles au client) : personne + couleur + taille.
        // « Personne » vient d'une liste de groupe : chaque ligne de la commande
        // indique alors à qui le vêtement est destiné (nécessaire à l'atelier).
        if (it.personName) properties['Personne'] = it.personName;
        // Rattache la ligne à sa liste de groupe : les lignes d'une même
        // commande restent lisibles comme un ensemble (« 2/5 »).
        if (it.groupLabel) properties['Liste'] = it.groupLabel;
        if (it.groupIndex) properties['Ligne'] = it.groupIndex;
        if (it.color) properties['Détails'] = it.color;
        if (it.size)  properties['Taille'] = it.size;

        // 🆕 Résumé groupe par tailles (ex: "2×M, 3×L") pour l'admin
        if (it._sizeGroupSummary) properties['_sizeGroupSummary'] = it._sizeGroupSummary;

        // N'accepte QUE des URLs http(s) hébergées comme valeur de propriété.
        // Une data-URL (base64) ferait des milliers de caractères -> Shopify
        // REJETTE /cart/add.js (propriété trop longue) et le checkout échoue.
        var httpUrl = function (u) {
          return (typeof u === 'string' && /^https?:\/\//i.test(u)) ? u : null;
        };

        // URLs techniques (aperçu + logos) : préfixe "_" -> cachées au checkout,
        // visibles dans l'admin. Aperçu = planche (sheet) si dispo, sinon vignette.
        var apercu = httpUrl(it.sheet) || httpUrl(it.img);
        if (apercu) properties['_Aperçu'] = apercu;
        if (Array.isArray(it.assets)) {
          it.assets.forEach(function (a) {
            if (a && a.label && httpUrl(a.url)) properties['_' + a.label] = a.url;
          });
        }

        var qty = Math.max(1, parseInt(it.qty, 10) || 1);
        items.push({
          id: variantId,
          quantity: qty,
          properties: Object.keys(properties).length ? properties : undefined
        });

        // Supplément « personnalisation manches » : ligne de panier distincte.
        // Le variant textile a un prix fixe et une line item property ne porte
        // aucun prix — le supplément doit donc être un vrai article (produit
        // add-on masqué). Quantité = nb de manches × quantité de l'article.
        var sleeves = Math.max(0, parseInt(it.sleeveCount, 10) || 0);
        /* Variant à la couleur de l'article quand il existe, ancien variant
           unique sinon (voir sleeveVariantForItem). */
        var sleeveVariant = sleeveVariantForItem(it);
        if (sleeves > 0 && sleeveVariant) {
          items.push({
            id: sleeveVariant,
            quantity: sleeves * qty,
            properties: {
              'Article': (it.name || 'Textile') + (it.size ? ' — ' + it.size : ''),
              'Manches': sleeves > 1 ? 'Gauche + droite' : 'Une manche'
            }
          });
        } else if (sleeves > 0) {
          /* L'ID du produit add-on manque : le supplément ne peut pas être
             facturé. On le SIGNALE au lieu d'échouer en silence.

             C'est précisément ce silence qui a laissé le défaut vivre : le bloc
             n'avait ni else, ni log, ni entrée dans `skipped`. Le client voyait
             le bon montant jusqu'au dernier écran, et la commande paraissait
             cohérente côté commerçant — un textile à son prix nu.

             Même esprit que le repli couleur plus haut, qui trace ses
             substitutions dans __variantColorFallbacks. */
          console.warn('[recap] Supplément manches NON facturé : ' +
                       'window.CONF_SLEEVE_VARIANT est absent.', it);
        }
      });
      return { items: items, skipped: skipped };
    }

    /* Synchronise le panier local vers le panier natif Shopify puis redirige
       vers le checkout Shopify (où le client saisit ses coordonnées et paie). */
    /* Active/désactive le bouton Commander selon la case de consentement.
       Exposé sur window : l'attribut onchange="..." s'exécute dans le scope
       GLOBAL, pas dans cette IIFE. Sans ça, la case ne débloquait rien. */
    function onConsentChange() {
      var chk = document.getElementById('rcp-consent-chk');
      var btn = document.getElementById('rcp-continue');
      if (!btn) return;
      var ok = !!(chk && chk.checked);
      btn.disabled = !ok;
      // render() peut avoir posé ces styles inline pour un panier vide :
      // on les nettoie pour ne pas laisser le bouton inerte.
      btn.style.pointerEvents = ok ? '' : 'none';
      btn.style.opacity = ok ? '' : '';
    }
    window.onConsentChange = onConsentChange;

    async function goToCheckout(btnEl) {
      // Garde-fou : consentement obligatoire (au cas où le bouton serait forcé).
      var consent = document.getElementById('rcp-consent-chk');
      if (!consent || !consent.checked) {
        await confAlert(
          'Merci d\'accepter les conditions avant de commander.',
          { icon: 'info', title: 'Consentement requis' }
        );
        return;
      }

      var cart = getCart();
      if (!cart.length) { await confAlert('Votre panier est vide.', { icon: 'info', title: 'Panier vide' }); return; }

      var built = buildShopifyItems(cart);
      var items = built.items, skipped = built.skipped;

      /* Ces deux garde-fous reposent ENTIÈREMENT sur `skipped`, donc sur le fait
         que variantForItem() renvoie `undefined` pour les coins. Ils étaient
         inatteignables tant qu'un variant était câblé pour `patches` : les coins
         partaient au paiement à un prix jamais validé. Voir CONF_VARIANTS. */

      // Panier composé uniquement d'articles sur devis (coins) : pas de checkout.
      if (!items.length) {
        await confAlert(
          "Votre panier ne contient que des articles sur devis (coins). " +
          "Utilisez le bouton « Faire une demande de devis » depuis le configurateur.",
          { icon: 'info', title: 'Articles sur devis' }
        );
        return;
      }
      if (skipped.length) {
        var ok = await confConfirm(
          skipped.length + " article(s) sur devis (coins) ne peuvent pas être payés en ligne " +
          "et seront retirés. Continuer avec les " + items.length + " autre(s) article(s) ?",
          { icon: 'warning', title: 'Articles retirés', confirmText: 'Continuer' }
        );
        if (!ok) return;
      }

      /* Couleurs substituées : le client doit le savoir AVANT de payer. Le prix
         est le bon, mais la commande et la facture porteront une autre teinte —
         sur du textile personnalisé, donc non revendable, c'est un motif de
         litige. On demande confirmation plutôt que d'informer après coup. */
      var subs = window.__variantColorFallbacks || [];
      if (subs.length) {
        var liste = subs.slice(0, 3).map(function (s) {
          return '« ' + s.asked + ' » → « ' + s.used + ' »';
        }).join(', ');
        var okColor = await confConfirm(
          subs.length + ' couleur(s) ne sont pas disponibles à la commande et seront ' +
          'remplacées : ' + liste + (subs.length > 3 ? ' …' : '') + '. ' +
          'Le prix ne change pas. Continuer ?',
          { icon: 'warning', title: 'Couleur remplacée', confirmText: 'Continuer' }
        );
        if (!okColor) return;
      }

      if (btnEl) { btnEl.disabled = true; btnEl.textContent = 'Redirection…'; }

      try {
        /* 1) VÉRIFIER l'ajout AVANT de vider.

           L'ordre était inversé : `/cart/clear.js` puis `/cart/add.js`. Si
           l'ajout échouait (variant épuisé, propriété refusée, réseau), le
           panier Shopify avait déjà été détruit et rien ne le restaurait — le
           client se retrouvait avec un panier vide ET une erreur.

           On ajoute donc d'abord, et on ne nettoie qu'ensuite : Shopify cumule
           les quantités sur un même variant, d'où le retrait des lignes
           préexistantes une fois l'ajout confirmé. `conf_cart` reste la source
           de vérité côté client, donc l'état affiché ne dépend pas de ce
           nettoyage. */
        /* On mémorise la QUANTITÉ de chaque ligne, pas seulement sa clé.

           Shopify regroupe les lignes par (variante + propriétés identiques) :
           une ligne ajoutée qui correspond à une ligne existante la REJOINT et
           garde la même clé. Ne retenir que les clés faisait donc supprimer, à
           l'étape 2, une ligne qu'on venait d'ajouter.

           C'est ce qui effaçait le supplément manche : ses propriétés sont
           stables (`Article`, `Manches`), donc sa clé ne change jamais. Le
           textile, lui, survivait — ses propriétés varient à chaque design
           (`_Aperçu`, URLs des logos), d'où une clé neuve à chaque ajout. */
        var before = null;
        try {
          var cur = await fetch('/cart.js', { headers: { 'Accept': 'application/json' } });
          if (cur.ok) {
            var curCart = await cur.json();
            before = {};
            (curCart.items || []).forEach(function (it) { before[it.key] = it.quantity; });
          }
        } catch (e) { before = null; }

        var res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        });
        if (!res.ok) {
          var txt = await res.text().catch(function () { return ''; });
          throw new Error('Ajout au panier Shopify échoué (' + res.status + '). ' + txt);
        }

        /* 2) L'ajout a réussi : on retire les lignes qui préexistaient, pour
              éviter les doublons au retour depuis le checkout. Un échec ici est
              sans gravité (au pire un doublon), d'où le catch silencieux — il
              ne doit surtout pas empêcher le paiement.

              On relit le panier APRÈS l'ajout et on ne retranche que la
              quantité d'ORIGINE : une ligne qui a grossi entre-temps a reçu
              notre ajout, la vider effacerait ce qu'on vient de mettre. */
        var apres = null;
        try {
          var c2 = await fetch('/cart.js', { headers: { 'Accept': 'application/json' } });
          if (c2.ok) {
            var cart2 = await c2.json();
            apres = {};
            (cart2.items || []).forEach(function (it) { apres[it.key] = it.quantity; });
          }
        } catch (e) { apres = null; }

        if (before && Object.keys(before).length) {
          var updates = {};
          Object.keys(before).forEach(function (key) {
            var avant = before[key];
            var maintenant = apres ? (apres[key] || 0) : avant;
            /* Ligne inchangée -> elle est bien un reliquat, on la vide.
               Ligne qui a grossi -> notre ajout l'a rejointe : on ne retire que
               l'ancienne quantité et on garde la nôtre. */
            var cible = Math.max(0, maintenant - avant);
            updates[key] = cible;
          });
          try {
            await fetch('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ updates: updates })
            });
          } catch (e) {
            console.warn('Nettoyage des lignes précédentes échoué (doublon possible) :', e);
          }
        }

        // 3) Marque qu'un checkout est en cours. Au retour sur le configurateur,
        //    si le panier Shopify natif est vide (commande finalisée), on purge le
        //    design. On NE purge PAS ici : le client peut revenir en arrière et
        //    doit retrouver son panier tant que le paiement n'est pas confirmé.
        try { localStorage.setItem('conf_checkout_pending', String(Date.now())); } catch (e) {}
        window.location.href = '/checkout';
      } catch (err) {
        console.error('Erreur checkout :', err);
        if (btnEl) { btnEl.disabled = false; btnEl.textContent = 'Commander'; }
        confAlert("Une erreur est survenue lors du passage au paiement.\n" + err.message, { icon: 'error', title: 'Erreur' });
      }
    }

    // Exposé pour le onclick inline du bouton "Commander".
    window.goToCheckout = goToCheckout;

    /* Écrit un montant dans un élément, s'il existe. Les quatre conteneurs de
       cette page sont statiques, mais render() est rappelée sur l'événement
       conf:prices-loaded : une garde évite qu'un rendu tardif, après une
       navigation, ne lève une TypeError qui interromprait le recalcul. */
    function setMoney(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = money(value);
    }

    function render() {
      const items = getCart();
      const itemsEl = document.getElementById('rcp-items');
      const contBtn = document.getElementById('rcp-continue');
      if (!itemsEl || !contBtn) return;   // page partiellement montée

      if (!items.length) {
        itemsEl.innerHTML = `
          <div class="rcp-empty">
            Votre récapitulatif est vide.<br>
            <a href="/pages/configurateur">← Retour au configurateur</a>
          </div>`;
        setMoney('rcp-subtotal', 0);
        setMoney('rcp-total', 0);
        contBtn.disabled = true;
        contBtn.style.opacity = '0.5';
        contBtn.style.pointerEvents = 'none';
        return;
      }

      // Panier non vide : on lève le verrou « panier vide » posé plus haut.
      // Le bouton reste toutefois soumis à la case de consentement.
      contBtn.style.opacity = '';
      contBtn.style.pointerEvents = '';
      if (typeof onConsentChange === 'function') onConsentChange();

      // Quantité totale par type -> palier dégressif appliqué à l'affichage.
      var totalsByType = {};
      items.forEach(function (i) {
        totalsByType[i.productType] = (totalsByType[i.productType] || 0) + (i.qty || 1);
      });

      let subtotal = 0;
      itemsEl.innerHTML = items.map((item, idx) => {
        const unit = effectiveUnitPrice(item, totalsByType);
        const lineTotal = unit * (item.qty || 1);
        subtotal += lineTotal;

        // Propriétés : textile = couleur + taille séparés ; custom = détails bruts
        let propsHtml = '';
        if (item.size) {
          const parts = [];
          /* Surnom floqué : présent uniquement sur les lignes issues d'une
             commande de groupe (une ligne par personne). Affiché EN PREMIER,
             c'est lui qui distingue deux articles par ailleurs identiques.
             Le drawer du panier l'affiche déjà (conf-main-inline.js:3755) ;
             le récapitulatif était le seul écran à l'omettre. */
          /* L'étiquette est en <strong> (gris léger via CSS) et la VALEUR en
             .rcp-val (foncée, grasse) : c'est « Apricot » ou « S » qu'on
             cherche du regard, pas le mot « Couleur ». Même rendu que le
             tiroir du panier (conf-main-inline.js, cdLignesMeta). */
          const ligneProp = (etiquette, valeur) =>
            `<span><strong>${etiquette} :</strong> <span class="rcp-val">${esc(valeur)}</span></span>`;
          if (item.personName) parts.push(ligneProp('Nom floqué', item.personName));
          /* `item.color` arrive parfois PRÉFIXÉ ("Couleur : Atoll") : les lignes
             de groupe le stockent ainsi (conf-main-inline.js:2021) pour le
             panier Shopify. On retire le préfixe à l'affichage, sinon la ligne
             se lisait « Couleur : Couleur : Atoll ». Le stockage n'est pas
             touché : il alimente aussi les propriétés de commande. */
          if (item.color) {
            const couleur = String(item.color).replace(/^\s*Couleur\s*:\s*/i, '');
            parts.push(ligneProp('Couleur', couleur));
          }
          /* Même traitement pour la taille, stockée « Taille : M » sur certaines
             lignes de groupe. */
          parts.push(ligneProp('Taille', String(item.size).replace(/^\s*Taille\s*:\s*/i, '')));
          propsHtml = parts.join('');
        } else if (item.color) {
          // Custom (drapeau/patch) : les détails sont déjà formatés
          propsHtml = `<span>${esc(item.color)}</span>`;
        }

        const img = item.img
          ? `<img class="rcp-item-img" src="${esc(item.img)}" alt="${esc(item.name)}">`
          : `<div class="rcp-item-img rcp-item-noimg">
               <svg width="32" height="32" viewBox="0 0 24 24" fill="#c9ccd1"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
             </div>`;
        return `
          <div class="rcp-item">
            ${img}
            <div class="rcp-item-info">
              <div class="rcp-item-name">${esc(item.name)}</div>
              <div class="rcp-item-props">${propsHtml}</div>
            </div>
            <div class="rcp-item-right">
              <div class="rcp-item-price">${money(lineTotal)}</div>
              <div class="rcp-item-qty">Qté : ${item.qty || 1}</div>
              <button type="button" class="rcp-item-remove" data-idx="${idx}">Retirer</button>
            </div>
          </div>`;
      }).join('');

      setMoney('rcp-subtotal', subtotal);
      setMoney('rcp-total', subtotal);

      // Boutons "Retirer"
      itemsEl.querySelectorAll('.rcp-item-remove').forEach(btn => {
        btn.addEventListener('click', () => {
          const list = getCart();
          list.splice(parseInt(btn.dataset.idx, 10), 1);
          saveCart(list);
          render();
        });
      });
    }

    render();

    /* Les prix et grilles arrivent APRÈS ce premier rendu : on recalcule les
       totaux à leur réception, sinon la page resterait sur les valeurs de
       repli jusqu'au prochain rechargement. */
    document.addEventListener('conf:prices-loaded', render);
  })();
</script>

{% schema %}
{
  "name": "Récapitulatif",
  "settings": []
}
{% endschema %}
