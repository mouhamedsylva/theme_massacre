<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --black: #1a1a1a;
    --muted: #888;
    --faint: #aaa;
    --border: #e8e8e8;
    --bg-light: #fafafa;
  }
  .recap-page {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    color: var(--black);
    background: #fff;
    min-height: 100vh;
  }

  /* Header + étapes (repris du configurateur) */
  .rcp-hdr {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 24px; border-bottom: 1px solid var(--border);
    flex-wrap: wrap; gap: 16px;
  }
  /* Bloc marque VISIBLE depuis le 14/08/2026.

     Il portait `visibility: hidden` parce que le menu Horizon de la boutique
     s'affichait au-dessus, logo « M » compris : le nôtre faisait doublon à
     quelques pixels d'écart. Ce menu est désormais masqué sur cette page (voir
     la règle `#header-component .header-menu` plus bas), la raison du masquage
     a donc disparu — et le logo redevient le seul repère de marque de l'écran. */
  .rcp-brand {
    display: flex; align-items: center; gap: 12px;
  }

  /* MENU DE LA BOUTIQUE MASQUÉ sur cette page (14/08/2026).

     Cette page passe par theme.liquid, qui rend le header Horizon complet :
     menu (POPOTE WAR, NOUVEAUTÉS…), logo « M » et actions EUR / recherche /
     compte / panier. Le parcours de commande a son propre en-tête juste en
     dessous (.rcp-hdr) : les deux barres se superposaient, avec deux logos à
     quelques pixels d'écart.

     On cible `.header-section`, la classe que Shopify pose sur le wrapper de
     la section header (déclarée dans le schema de sections/header.liquid), et
     non un id : celui-ci contient un identifiant numérique de section, qui
     change à chaque duplication du thème.

     La BANDE ROUGE n'est PAS affectée : elle est injectée par une app tierce
     (BSS Banner) en dehors de `#header-group`, donc hors de ce sélecteur.
     Vérifié sur le HTML servi.

     `display: none` et non `visibility: hidden` : contrairement à .rcp-brand
     ci-dessus, on veut ici récupérer la hauteur — sinon une bande vide de la
     taille du menu resterait entre la bannière et le récapitulatif. */
  .header-section { display: none; }
  .rcp-brand-icon {
    /* Sans fond noir, comme .hdr-icon : le logo est un « M » noir sur
       transparent, un fond sombre le masquerait. */
    width: 40px; height: 40px; border-radius: 8px;
    color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px;
    overflow: hidden;
  }
  .rcp-brand-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .rcp-brand-name { font-size: 15px; font-weight: 800; letter-spacing: .3px; }
  .rcp-brand-sub { font-size: 11px; color: var(--muted); }

  .rcp-steps { display: flex; align-items: center; gap: 8px; }
  .rcp-step { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 12px; }
  .rcp-step-n {
    width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700;
  }
  .rcp-step.on .rcp-step-n { background: var(--black); border-color: var(--black); color: #fff; }
  .rcp-step.on .rcp-step-lbl { color: var(--black); font-weight: 600; }
  .rcp-step-line { width: 36px; height: 1px; background: var(--border); }

  .rcp-back {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border: 1px solid var(--border); border-radius: 8px;
    background: #fff; font-size: 12px; font-weight: 600; color: var(--black);
    cursor: pointer; text-decoration: none;
  }
  .rcp-back:hover { background: var(--bg-light); }

  /* « Revenir vers l'accueil », dans le bloc marque à GAUCHE (`.rcp-back` seul
     est pensé pour « Modifier », à droite de l'en-tête).

     `margin-left` : .rcp-brand n'a que 12px de `gap`, ce qui collait le bouton
     au libellé « RÉCAPITULATIF / Vérifiez votre commande ». 20px portent
     l'écart à 32px — la même respiration que dans l'en-tête du configurateur.
     `nowrap` garde le libellé sur une ligne quand l'en-tête se resserre. */
  .rcp-home {
    margin-left: 20px;
    white-space: nowrap;
  }
  .rcp-home svg { flex-shrink: 0; }

  /* Le logo est un LIEN : signaler qu'il est cliquable et neutraliser les
     styles que le navigateur applique aux liens. */
  a.rcp-brand-icon {
    cursor: pointer;
    text-decoration: none;
    transition: opacity .15s ease;
  }
  a.rcp-brand-icon:hover { opacity: .75; }

  /* Corps */
  .rcp-body {
    max-width: 1100px; margin: 0 auto; padding: 32px 24px 60px;
    display: grid; grid-template-columns: 1fr 340px; gap: 32px;
  }
  @media (max-width: 900px) { .rcp-body { grid-template-columns: 1fr; } }

  /* ── TÉLÉPHONE ─────────────────────────────────────────────────────────
     Seule la grille de `.rcp-body` était adaptée : l'en-tête, lui, débordait
     horizontalement — le bouton « Revenir vers l'accueil » sortait de l'écran.

     `.rcp-brand` est en `display: flex` SANS `flex-wrap` et contient logo,
     texte et bouton ; `.rcp-home` porte en outre `white-space: nowrap` et
     `margin-left: 20px`. Sur une largeur de téléphone, rien ne pouvait donc
     ni se replier ni rétrécir. */
  @media (max-width: 600px) {
    /* Filet de sécurité : quel que soit l'élément fautif, la page ne défile
       jamais horizontalement. */
    .recap-page { overflow-x: hidden; }

    .rcp-hdr { padding: 12px 16px; gap: 10px; }

    /* Le bloc marque peut passer à la ligne, et le bouton descendre sous le
       logo plutôt que de pousser la largeur. */
    .rcp-brand { flex-wrap: wrap; gap: 10px; min-width: 0; }
    /* `margin-left` de 20px écartait le bouton du texte sur grand écran ; il
       n'a plus lieu d'être une fois le bouton passé à la ligne. */
    .rcp-home { margin-left: 0; }

    /* Le nom de la marque peut être tronqué proprement plutôt que d'imposer sa
       largeur au conteneur. */
    .rcp-brand-name, .rcp-brand-sub {
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* FIL D'ÉTAPES : seuls les numéros restent.

       Trois libellés (« Personnalisation », « Récapitulatif », « Commande »)
       plus deux traits de 36 px dépassent largement une largeur de téléphone :
       « Commande » sortait de l'écran. Les libellés sont purement indicatifs —
       l'étape courante est déjà signalée par la pastille noire, et la page
       porte son propre titre juste en dessous.

       Le libellé de l'étape COURANTE est conservé : c'est la seule information
       du fil qui ne soit pas redondante avec la pastille. */
    .rcp-steps { gap: 6px; flex-wrap: nowrap; min-width: 0; }
    .rcp-step-lbl { display: none; }
    .rcp-step.on .rcp-step-lbl { display: inline; }
    .rcp-step-line { width: 16px; }
    .rcp-body { padding: 20px 16px 48px; gap: 20px; }
    .rcp-title { font-size: 19px; }

    /* Ligne d'article : la vignette garde sa taille, le texte se comprime.
       `min-width: 0` est indispensable — sans lui un élément flex refuse de
       passer sous la largeur de son contenu, et c'est le prix qui sortait. */
    .rcp-item-info { min-width: 0; }
    .rcp-item-name { overflow-wrap: anywhere; }
  }

  .rcp-title { font-size: 22px; font-weight: 800; margin-bottom: 4px; }
  .rcp-subtitle { font-size: 13px; color: var(--muted); margin-bottom: 24px; }

  /* Liste des produits */
  .rcp-items { display: flex; flex-direction: column; gap: 14px; }
  .rcp-item {
    display: flex; gap: 16px; align-items: center;
    padding: 16px; border: 1px solid var(--border); border-radius: 12px; background: #fff;
  }
  .rcp-item-img {
    width: 84px; height: 84px; border-radius: 8px; flex-shrink: 0;
    background: var(--bg-light); border: 1px solid var(--border);
    object-fit: contain;
  }
  .rcp-item-noimg {
    display: flex; align-items: center; justify-content: center;
  }
  .rcp-item-info { flex: 1; min-width: 0; }
  .rcp-item-name { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
  /* Une information PAR LIGNE (Nom floqué / Couleur / Taille), comme le tiroir
     du panier. Les <span> étaient posés côte à côte : sur une ligne de groupe
     les trois informations se bousculaient et débordaient sur les écrans
     étroits. */
  .rcp-item-props {
    font-size: 11px; color: var(--muted); line-height: 1.5;
    display: flex; flex-direction: column;
  }
  /* `> span` seulement : sans le sélecteur d'enfant direct, la marge
     s'appliquait aussi au .rcp-val imbriqué et décalait chaque valeur. */
  .rcp-item-props > span { display: block; }
  /* C'est la VALEUR qui porte le poids, pas l'étiquette. */
  .rcp-item-props strong { font-weight: 400; color: var(--muted); }
  .rcp-item-props .rcp-val { font-weight: 700; color: var(--black); }
  .rcp-item-right { text-align: right; flex-shrink: 0; }
  .rcp-item-price { font-size: 15px; font-weight: 800; }
  .rcp-item-qty { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .rcp-item-remove {
    margin-top: 8px; font-size: 11px; color: #c0392b; background: none; border: none;
    cursor: pointer; font-weight: 600;
  }
  .rcp-item-remove:hover { text-decoration: underline; }

  .rcp-empty {
    text-align: center; padding: 60px 20px; color: var(--muted);
    border: 1px dashed var(--border); border-radius: 12px;
  }
  .rcp-empty a { color: var(--black); font-weight: 700; }

  /* Récap prix (colonne droite) */
  .rcp-summary {
    border: 1px solid var(--border); border-radius: 12px; padding: 20px;
    position: sticky; top: 24px; height: fit-content;
  }
  .rcp-summary-title {
    font-size: 12px; font-weight: 800; letter-spacing: .5px;
    text-transform: uppercase; margin-bottom: 16px;
  }
  .rcp-line { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 10px; color: #444; }
  .rcp-line-total {
    display: flex; justify-content: space-between; align-items: baseline;
    font-size: 18px; font-weight: 800; margin-top: 14px; padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .rcp-total-vat { font-size: 11px; color: var(--muted); font-weight: 400; }
  .rcp-note { font-size: 10px; color: var(--faint); margin-top: 4px; }

  /* Consentement (au-dessus du bouton Commander). */
  .rcp-consent {
    display: flex; align-items: flex-start; gap: 10px;
    margin-top: 18px; padding: 12px 14px;
    background: #f8f8f8; border: 1px solid var(--border); border-radius: 10px;
    font-size: 12px; line-height: 1.5; color: #444; cursor: pointer;
    transition: border-color .15s, background .15s;
  }
  .rcp-consent:hover { border-color: #bbb; }
  .rcp-consent input {
    flex: none; width: 17px; height: 17px; margin-top: 1px;
    accent-color: var(--black); cursor: pointer;
  }
  .rcp-consent a { color: var(--black); text-decoration: underline; }
  /* Mise en avant discrète tant que ce n'est pas coché. */
  .rcp-consent:has(input:not(:checked)) { border-color: #e0c088; background: #fdf8ee; }

  .rcp-continue {
    width: 100%; margin-top: 14px; padding: 14px; background: var(--black); color: #fff;
    border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: background .2s, opacity .2s;
  }
  .rcp-continue:hover:not(:disabled) { background: #333; }
  .rcp-continue:disabled { opacity: .45; cursor: not-allowed; }

  .rcp-return {
    width: 100%; margin-top: 10px; padding: 12px; background: #fff; color: var(--black);
    border: 1px solid var(--border); border-radius: 10px; font-size: 13px; font-weight: 600;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;
    transition: background .2s;
  }
  .rcp-return:hover { background: var(--bg-light); }

  .rcp-trust { margin-top: 18px; display: flex; flex-direction: column; gap: 10px; }
  .rcp-trust-item { display: flex; gap: 8px; align-items: flex-start; font-size: 11px; color: #555; }
  .rcp-trust-item svg { flex-shrink: 0; margin-top: 1px; }
</style>

<div class="recap-page">
  <!-- Header + étapes -->
  <header class="rcp-hdr">
    <div class="rcp-brand">
      {%- comment -%}
        Logo cliquable vers l'accueil, comme dans l'en-tête du configurateur.
        `routes.root_url` plutôt qu'une URL en dur : Shopify y injecte le
        préfixe de langue/marché courant, et l'aperçu du thème brouillon reste
        sur le brouillon.
      {%- endcomment -%}
      <a class="rcp-brand-icon" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — retour à l'accueil">
        {%- comment -%}
          `width`/`height` : dimensions intrinsèques déclarées pour que le
          navigateur réserve la place avant le chargement (pas de saut de mise
          en page). Le CSS ci-dessus les surcharge en 100%/100% dans la boîte
          de 40px de .rcp-brand-icon, avec `object-fit: contain`.
        {%- endcomment -%}
        <img src="{{ 'logo-massacre.png' | asset_url }}" alt="{{ shop.name | escape }}" width="40" height="40">
      </a>
      <div>
        <div class="rcp-brand-name">RÉCAPITULATIF</div>
        <div class="rcp-brand-sub">Vérifiez votre commande</div>
      </div>

      {%- comment -%}
        « Revenir vers l'accueil » — pendant exact du bouton de l'en-tête du
        configurateur. Le menu de la boutique étant masqué sur cette page (voir
        `.header-section` dans le <style>), c'est désormais le seul chemin de
        retour vers la boutique ; le logo seul n'indiquerait pas qu'il est
        cliquable.

        Réutilise `.rcp-back`, la classe du bouton « Modifier » à droite du même
        en-tête : mêmes bordure, arrondi et survol, et son responsive est déjà
        écrit. Un style dédié ferait double emploi.
      {%- endcomment -%}
      <a class="rcp-back rcp-home" href="{{ routes.root_url }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        Revenir vers l'accueil
      </a>
    </div>

    <div class="rcp-steps">
      <div class="rcp-step">
        <div class="rcp-step-n">1</div>
        <span class="rcp-step-lbl">Personnalisation</span>
      </div>
      <div class="rcp-step-line"></div>
      <div class="rcp-step on">
        <div class="rcp-step-n">2</div>
        <span class="rcp-step-lbl">Récapitulatif</span>
      </div>
      <div class="rcp-step-line"></div>
      <div class="rcp-step">
        <div class="rcp-step-n">3</div>
        <span class="rcp-step-lbl">Commande</span>
      </div>
    </div>

    <!-- ?cart=1 : le configurateur rouvre le drawer à l'arrivée. « Modifier »
         doit ramener à l'écran qu'on vient de quitter — panier visible — et
         non à un configurateur d'apparence vierge. Les designs, eux, sont
         déjà restaurés depuis sessionStorage. -->
    <a href="/pages/configurateur?cart=1" class="rcp-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      Modifier
    </a>
  </header>

  <!-- Corps -->
  <div class="rcp-body">
    <div>
      <h1 class="rcp-title">Votre récapitulatif</h1>
      <p class="rcp-subtitle">Vérifiez les produits et les prix avant de passer commande.</p>
      <div class="rcp-items" id="rcp-items">
        <!-- Rempli par JS depuis /cart.js -->
        <div class="rcp-empty">Chargement du panier…</div>
      </div>
    </div>

    <!-- Récap prix -->
    <aside class="rcp-summary">
      <div class="rcp-summary-title">Récapitulatif du prix</div>
      <div class="rcp-line">
        <span>Sous-total</span>
        <span id="rcp-subtotal">—</span>
      </div>
      <div class="rcp-line">
        <span>Livraison</span>
        <span>Calculée à l'étape suivante</span>
      </div>
      <div class="rcp-line-total">
        <span>Total</span>
        <span><span id="rcp-total">—</span> <span class="rcp-total-vat">TTC</span></span>
      </div>
      <p class="rcp-note">Taxes incluses. Livraison calculée à l'étape suivante.</p>

      <!-- Consentement : le bouton Commander reste bloqué tant que la case
           n'est pas cochée. Article personnalisé = pas de retour possible,
           d'où l'acceptation explicite avant paiement. -->
      <label class="rcp-consent" for="rcp-consent-chk">
        <input type="checkbox" id="rcp-consent-chk" onchange="onConsentChange()">
        <span>
          J'ai vérifié mon design (texte, couleurs, placement) et j'accepte les
          <a href="/policies/terms-of-service" target="_blank" rel="noopener">conditions générales de vente</a>.
          Les articles personnalisés ne sont ni repris ni échangés.
        </span>
      </label>

      <button type="button" class="rcp-continue" id="rcp-continue" onclick="goToCheckout(this)" disabled>
        Commander
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
      </button>
      <!-- Même destination que « Modifier » en en-tête : les deux ramènent au
           configurateur, ils doivent y trouver le même écran. -->
      <button type="button" class="rcp-return" onclick="window.location.href='/pages/configurateur?cart=1'">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        Retour au configurateur
      </button>

      <div class="rcp-trust">
        <div class="rcp-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#666"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
          Paiement 100% sécurisé
        </div>
        {% comment %} <div class="rcp-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#666"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z"/></svg>
          Livraison rapide sous 5 à 7 jours
        </div> {% endcomment %}
      </div>
    </aside>
  </div>
</div>

<script src="{{ 'conf-alert.js' | asset_url }}"></script>
<!-- Grille dégressive + helpers (tierUnitPrice, effectiveUnitPrice).
     Cette page les utilisait SANS charger l'asset : elle retombait sur le
     repli « prix de la ligne » et ignorait donc les paliers. -->
<script src="{{ 'conf-pricing-tiers.js' | asset_url }}"></script>
<script>
  /* Même résolution d'URL que le configurateur : le réglage de thème prime,
     l'URL en dur ne sert que de repli. VPS OVH depuis le 11/08/2026.
     Les deux replis DOIVENT rester identiques : cette page déclenche le
     paiement, une divergence enverrait le devis sur une autre instance que
     celle qui a calculé le panier. */
  {%- assign api_setting = settings.api_endpoint | default: '' -%}
  {%- if api_setting == '' or api_setting contains 'localhost' -%}
    window.API_BASE = "https://vps-c1a07d74.vps.ovh.net/api";
  {%- else -%}
    window.API_BASE = {{ api_setting | json }};
  {%- endif -%}

  /* Grilles définies dans l'admin : elles remplacent la table de repli.
     Le récapitulatif recalcule ses totaux dès qu'elles arrivent, sinon il
     afficherait les anciens paliers jusqu'au prochain rechargement. */
  fetch(window.API_BASE + '/pricing')
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) {
      if (!d || !d.ok) return;
      if (d.prices) window.PRICES = Object.assign({}, window.PRICES, d.prices);
      /* Produits SUR DEVIS forcés à 0 — même garde que configurateur.liquid.
         C'est la page qui déclenche le paiement : un prix servi par erreur y
         coûte plus cher qu'ailleurs. Le backend renvoie encore `coins: 2.45`
         tant qu'il n'est pas redéployé (ligne `price_coins` héritée de la
         boutique de développement). */
      if (window.PRICES) window.PRICES.coins = 0;
      /* Validée avant application — même raison que dans configurateur.liquid :
         un prix ≤ 0 venant du backend ne doit pas écraser la grille de repli.
         C'est la page qui déclenche le paiement, donc celle où un prix faux
         coûte le plus cher. */
      if (d.tiers && typeof d.tiers === 'object') {
        if (typeof window.applyTiersFromBackend === 'function') {
          window.applyTiersFromBackend(d.tiers);
        } else {
          window.QTY_TIERS = d.tiers;
        }
      }
      document.dispatchEvent(new CustomEvent('conf:prices-loaded'));
    })
    .catch(function () {});   // repli silencieux : la table locale reste en place
</script>
<script>
  /* Variants Shopify pour le panier natif (produits à prix fixe).

     Nommage interne INVERSÉ (voir configurateur.liquid) :
       'coins'   = PATCHS codés -> « Patch personnalisé » (achetable en ligne)
       'patches' = COINS réels  -> « Coin métal » (SUR DEVIS UNIQUEMENT)

     LES COINS N'ONT VOLONTAIREMENT PAS DE VARIANT. Ils sont chiffrés au cas par
     cas (finition, gravure, quantité) : aucun prix fixe ne peut leur être
     attribué, donc aucun variant ne doit permettre de les payer en ligne.

     C'est `variantForItem()` renvoyant `undefined` pour eux qui alimente
     `skipped` dans buildShopifyItems(), et qui déclenche les deux garde-fous de
