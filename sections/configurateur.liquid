{%- comment -%}
  Contenu du configurateur — le <body> UNIQUEMENT.

  Le document (<!DOCTYPE>, <html>, <head>) vit dans `layout/configurateur.liquid`,
  designe par `templates/page.configurateur.json` (cle `"layout":
  "configurateur"`). Ne PAS reintroduire ici de
  <!DOCTYPE>, <html>, <head> ni <body> : `{% section %}` enveloppe son rendu
  dans un <div class="shopify-section">, et un <div> avant le doctype fait
  basculer le navigateur en mode quirks — la page devient blanche.
{%- endcomment -%}
  <div class="conf-app-root">

  <!-- ══ HEADER ══ -->
  <header class="hdr">
    <div class="hdr-brand">
      <div class="hdr-icon"><img src="{{ 'logo-massacre.png' | asset_url }}" alt="Logo personnalisé"></div>
      <div>
        <div class="hdr-name">TEXTILE PERSONNALISÉ</div>
        <div class="hdr-sub">Créez votre style</div>
      </div>
    </div>

    <div class="hdr-steps">
      <div class="step on">
        <div class="step-n">1</div>
        <span class="step-lbl">Personnalisation</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <div class="step-n">2</div>
        <span class="step-lbl">Récapitulatif</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <div class="step-n">3</div>
        <span class="step-lbl">Commande</span>
      </div>
    </div>

    <div class="hdr-btns">
      {% comment %} <button type="button" class="obtn" onclick="shareDesign(this)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
        Partager
      </button> {% endcomment %}

      <!-- Icône panier (cachée par défaut) -->
      <button type="button" class="obtn obtn-cart" id="hdr-cart-btn" style="display:none" onclick="openCartDrawer()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM2.73 5.15L4 12h12.55c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 21 3H5.21l-.94-2H1v2h2l3.6 7.59z"/>
        </svg>
        <span id="hdr-cart-count" style="
          background:#1a1a1a; color:#fff;
          border-radius:50%; font-size:10px; font-weight:700;
          width:16px; height:16px;
          display:inline-flex; align-items:center; justify-content:center;
          margin-left:2px;
        ">0</span>
      </button>

      <button type="button" class="obtn" onclick="confirmReset()">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
        Réinitialiser
      </button>
    </div>
  </header>

  <!-- ══ TYPE BAR ══ (MASQUÉ - Déplacé dans sidebar) -->
  <div class="type-bar" style="display:none">
    <div class="type-bar-inner">
      <div class="type-bar-label">
        <div class="type-bar-num">1.</div>
        <div>
          <div class="type-bar-title">Type de produit</div>
          <div class="type-bar-sub">Choisissez le type</div>
        </div>
      </div>
      <div class="type-bar-cards">

        <div class="pt on" data-product="sweatshirt" onclick="selProd(this)">
          <span class="pt-ck">✓</span>
          <div class="pt-ico">
            <img class="pt-img" src="{{ 'sweatshirt-face.png' | asset_url }}" alt="Sweatshirt">
          </div>
          <span>Sweatshirt</span>
        </div>

        <div class="pt" data-product="tshirt" onclick="selProd(this)">
          <span class="pt-ck">✓</span>
          <div class="pt-ico">
            <img class="pt-img" src="{{ 'tshirt-face.png' | asset_url }}" alt="T-shirt coton">
          </div>
          <span>T-shirt coton</span>
        </div>

        <div class="pt" data-product="tshirt_polyester" onclick="selProd(this)">
          <span class="pt-ck">✓</span>
          <div class="pt-ico">
            <img class="pt-img" src="{{ 'tshirt-polyester-face.png' | asset_url }}" alt="T-shirt polyester">
          </div>
          <span>T-shirt polyester</span>
        </div>

        <div class="pt" data-product="coins" onclick="selProd(this)">
          <span class="pt-ck">✓</span>
          <div class="pt-ico">
            <img class="pt-img" src="{{ 'icon-coins.png' | asset_url }}" alt="Coins">
          </div>
          <span>Coins</span>
        </div>

        <div class="pt" data-product="drapeaux" onclick="selProd(this)">
          <span class="pt-ck">✓</span>
          <div class="pt-ico">
            <img class="pt-img" src="{{ 'icon-drapeaux.png' | asset_url }}" alt="Drapeaux">
          </div>
          <span>Drapeaux</span>
        </div>

        <div class="pt" data-product="patches" onclick="selProd(this)">
          <span class="pt-ck">✓</span>
          <div class="pt-ico">
            <img class="pt-img" src="{{ 'icon-patchs.png' | asset_url }}" alt="Patchs">
          </div>
          <span>Patchs</span>
        </div>

      </div>
    </div>
  </div>

  <!-- ══ APP ══ -->
  <div class="app">

    <!-- NOUVELLE SIDEBAR MODERNE -->
    {% render 'sidebar-modern' %}

    <!-- Inputs file cachés (nécessaires pour les uploads) -->
    <input type="file" id="uf" style="display:none" accept="image/*" onchange="doUpload(event,'f')">
    <input type="file" id="ufr" style="display:none" accept="image/*" onchange="doUpload(event,'fr')">
    <input type="file" id="ub" style="display:none" accept="image/*" onchange="doUpload(event,'b')">
    <input type="file" id="usl" style="display:none" accept="image/*" onchange="doUpload(event,'sl')">
    <input type="file" id="usr" style="display:none" accept="image/*" onchange="doUpload(event,'sr')">

    <!-- Coins : une entrée par face. Déclarées ici (et non dans le panneau)
         pour survivre au rechargement dynamique de la sidebar. -->
    <input type="file" id="uc-recto" style="display:none" accept="image/*,.pdf" onchange="doUpload(event,'coin-recto')">
    <input type="file" id="uc-verso" style="display:none" accept="image/*,.pdf" onchange="doUpload(event,'coin-verso')">

    <!-- Drapeaux : un design par face, mêmes raisons que ci-dessus. -->
    <input type="file" id="uf-recto" style="display:none" accept="image/*,.pdf" onchange="doUpload(event,'flag-recto')">
    <input type="file" id="uf-verso" style="display:none" accept="image/*,.pdf" onchange="doUpload(event,'flag-verso')">

    <!-- Patchs : une seule face (zone 'c'). -->
    <input type="file" id="uc" style="display:none" accept="image/*,.pdf" onchange="doUpload(event,'c')">

    <!-- ANCIENNE SIDEBAR (masquée mais conservée temporairement pour compatibilité) -->
    <aside class="sidebar" style="display:none">
      <div class="sb-inner" id="sidebar-content">

  <!-- 2. Couleur -->
        <div class="sec">
          <div class="sec-title">2. Couleur</div>
          <div class="sec-sub">Choisissez la couleur de votre article</div>
          <div class="cg">
            <div class="cs" style="background:#f5a623" title="Apricot" onclick="selColor(this,'#f5a623','Apricot')"></div>
            <div class="cs" style="background:#eff1f0;border:1.5px solid #ddd" title="Ash" onclick="selColor(this,'#eff1f0','Ash')"></div>
            <div class="cs" style="background:#3bb9e0" title="Atoll" onclick="selColor(this,'#3bb9e0','Atoll')"></div>
            <div class="cs on" style="background:#0a0a0a" title="Black" onclick="selColor(this,'#0a0a0a','Black')"></div>
            <div class="cs" style="background:#143f2e" title="Bottle Green" onclick="selColor(this,'#143f2e','Bottle Green')"></div>
            <div class="cs" style="background:#3a3130" title="Brown" onclick="selColor(this,'#3a3130','Brown')"></div>
            <div class="cs" style="background:#3d1f35" title="Burgundy" onclick="selColor(this,'#3d1f35','Burgundy')"></div>
            <div class="cs" style="background:#4a3830" title="Chocolate" onclick="selColor(this,'#4a3830','Chocolate')"></div>
            <div class="cs" style="background:#1e32e6" title="Cobalt Blue" onclick="selColor(this,'#1e32e6','Cobalt Blue')"></div>
            <div class="cs" style="background:#2e3944" title="Dark Grey" onclick="selColor(this,'#2e3944','Dark Grey')"></div>
            <div class="cs" style="background:#1e6b78" title="Diva Blue" onclick="selColor(this,'#1e6b78','Diva Blue')"></div>
            <div class="cs" style="background:#e01e1e" title="Fire Red" onclick="selColor(this,'#e01e1e','Fire Red')"></div>
            <div class="cs" style="background:#f5c518" title="Gold" onclick="selColor(this,'#f5c518','Gold')"></div>
            <div class="cs" style="background:#2fa84f" title="Kelly Green" onclick="selColor(this,'#2fa84f','Kelly Green')"></div>
            <div class="cs" style="background:#6e7bd8" title="Millennial Lilac" onclick="selColor(this,'#6e7bd8','Millennial Lilac')"></div>
            <div class="cs" style="background:#9ee5c4" title="Millennial Mint" onclick="selColor(this,'#9ee5c4','Millennial Mint')"></div>
            <div class="cs" style="background:#e8e2d0;border:1.5px solid #ddd" title="Natural" onclick="selColor(this,'#e8e2d0','Natural')"></div>
            <div class="cs" style="background:#1a2438" title="Navy" onclick="selColor(this,'#1a2438','Navy')"></div>
            <div class="cs" style="background:#1b2a5b" title="Navy Blue" onclick="selColor(this,'#1b2a5b','Navy Blue')"></div>
            <div class="cs" style="background:#f0500a" title="Orange" onclick="selColor(this,'#f0500a','Orange')"></div>
            <div class="cs" style="background:#7de01e" title="Orchid Green" onclick="selColor(this,'#7de01e','Orchid Green')"></div>
            <div class="cs" style="background:#f5c8dc;border:1.5px solid #e0afc4" title="Orchid Pink" onclick="selColor(this,'#f5c8dc','Orchid Pink')"></div>
            <div class="cs" style="background:#8a8d91" title="Pacific Grey" onclick="selColor(this,'#8a8d91','Pacific Grey')"></div>
            <div class="cs" style="background:#a8e020" title="Pixel Lime" onclick="selColor(this,'#a8e020','Pixel Lime')"></div>
            <div class="cs" style="background:#3a1e9e" title="Radiant Purple" onclick="selColor(this,'#3a1e9e','Radiant Purple')"></div>
            <div class="cs" style="background:#a81e32" title="Red" onclick="selColor(this,'#a81e32','Red')"></div>
            <div class="cs" style="background:#1e4be0" title="Royal Blue" onclick="selColor(this,'#1e4be0','Royal Blue')"></div>
            <div class="cs" style="background:#c4b49a" title="Sand" onclick="selColor(this,'#c4b49a','Sand')"></div>
            <div class="cs" style="background:#9ed8f0" title="Sky" onclick="selColor(this,'#9ed8f0','Sky')"></div>
            <div class="cs" style="background:#f5e518;border:1.5px solid #d4c518" title="Solar Yellow" onclick="selColor(this,'#f5e518','Solar Yellow')"></div>
            <div class="cs" style="background:#b01e78" title="Sorbet" onclick="selColor(this,'#b01e78','Sorbet')"></div>
            <div class="cs" style="background:#8a9499" title="Sport Grey" onclick="selColor(this,'#8a9499','Sport Grey')"></div>
            <div class="cs" style="background:#3e6b85" title="Stone Blue" onclick="selColor(this,'#3e6b85','Stone Blue')"></div>
            <div class="cs" style="background:#f5455e" title="Sunset Orange" onclick="selColor(this,'#f5455e','Sunset Orange')"></div>
            <div class="cs" style="background:#5ed0c4" title="Swimming Pool" onclick="selColor(this,'#5ed0c4','Swimming Pool')"></div>
            <div class="cs" style="background:#3a4130" title="Urban Khaki" onclick="selColor(this,'#3a4130','Urban Khaki')"></div>
            <div class="cs" style="background:#c43418" title="Urban Orange" onclick="selColor(this,'#c43418','Urban Orange')"></div>
            <div class="cs" style="background:#1e1e6e" title="Urban Purple" onclick="selColor(this,'#1e1e6e','Urban Purple')"></div>
            <div class="cs" style="background:#2e3438" title="Used Black" onclick="selColor(this,'#2e3438','Used Black')"></div>
            <div class="cs" style="background:#ffffff;border:1.5px solid #ddd" title="White" onclick="selColor(this,'#ffffff','White')"></div>
          </div>
        </div>

        <!-- 3. Taille -->
        <div class="sec">
          <div class="sec-title">3. Taille</div>
          <div class="sec-sub">Choisissez la taille</div>
          <div class="sg">
            <button type="button" class="sb" onclick="selSize(this)">XS</button>
            <button type="button" class="sb" onclick="selSize(this)">S</button>
            <button type="button" class="sb on" onclick="selSize(this)">M</button>
            <button type="button" class="sb" onclick="selSize(this)">L</button>
            <button type="button" class="sb" onclick="selSize(this)">XL</button>
            <button type="button" class="sb" onclick="selSize(this)">XXL</button>
            <button type="button" class="sb sb-group" onclick="openSizeQuantityModal()">Pour Groupe</button>
          </div>
          <a class="sgd" href="#" onclick="openSizeGuide(event)">📏 Guide des tailles</a>
        </div>

        <!-- 4. Texte : bouton -> champ inline -> panneau d'édition (façon CustomInk) -->
        <!-- 4. Personnalisation : toutes les options de design réunies en une
             liste dépliable. Chaque ligne ouvre sa zone de travail ; le reste
             reste replié, ce qui garde la barre latérale courte et lisible. -->
        <div class="sec" id="txt-sec">
          <div class="sec-title">4. Personnalisation</div>
          <div class="sec-sub">Composez votre design</div>
          <div class="perso-list">
          <div class="perso-item" id="pi-text">
            <button type="button" class="perso-head" onclick="togglePerso('text')">
              <span class="perso-ico">✏️</span>
              <span class="perso-txt">
                <span class="perso-name">Ajouter du texte</span>
                <span class="perso-sub">Cœur, poitrine droite ou dos</span>
              </span>
              <span class="perso-done">✓</span>
              <span class="perso-caret">›</span>
            </button>
            <div class="perso-body">

          <!-- État 1 : un seul bouton. L'emplacement est choisi à l'étape
               suivante, ce qui évite trois boutons de poids égal pour ce qui
               n'est qu'une seule action. -->
          <div id="txt-add-btns" class="txt-add-btns">
            <button type="button" class="txt-add-btn" onclick="startTextInline()">✏️ Ajouter un texte</button>
          </div>

          <!-- État 2 : emplacement + saisie (remplacent le bouton). -->
          <div class="txt-inline" id="txt-inline" style="display:none">
            <div class="txt-where-lbl">Emplacement <span class="txt-where-hint">(côtés du porteur)</span></div>
            <div class="txt-where" id="txt-where">
              <!-- Côtés nommés du point de vue du PORTEUR (comme les manches).
                   Les deux options poitrine portent leur côté : « Cœur » seul
                   n'indiquait pas qu'il s'agit du côté gauche. -->
              <button type="button" class="txt-where-opt on" data-zone="f"  onclick="setTextZoneChoice(this)" title="Côté cœur, à gauche du porteur">Cœur (g.)</button>
              <button type="button" class="txt-where-opt"    data-zone="fr" onclick="setTextZoneChoice(this)" title="Poitrine, à droite du porteur">Poitrine (d.)</button>
              <button type="button" class="txt-where-opt"    data-zone="b"  onclick="setTextZoneChoice(this)" title="Dos du vêtement">Dos</button>
            </div>
            <input type="text" id="txt-inline-input" maxlength="40" placeholder="Saisissez votre texte…">
            <div class="txt-inline-acts">
              <button type="button" class="txt-inline-btn sec" onclick="cancelTextInline()">Annuler</button>
              <button type="button" class="txt-inline-btn pri" onclick="confirmTextInline()">Insérer</button>
            </div>
          </div>

          <!-- Aperçu du texte FACE / DOS (chips) -->
          <div class="txt-chip" id="txt-chip-f">
            <span class="txt-chip-val" id="txt-chip-val-f"></span>
            <button type="button" class="rmv" title="Modifier" onclick="editText('f')">✎</button>
            <button type="button" class="rmv" title="Supprimer" onclick="removeText('f')">🗑</button>
          </div>
          <div class="txt-chip" id="txt-chip-fr">
            <span class="txt-chip-val" id="txt-chip-val-fr"></span>
            <button type="button" class="rmv" title="Modifier" onclick="editText('fr')">✎</button>
            <button type="button" class="rmv" title="Supprimer" onclick="removeText('fr')">🗑</button>
          </div>
          <div class="txt-chip" id="txt-chip-b">
            <span class="txt-chip-val" id="txt-chip-val-b"></span>
            <button type="button" class="rmv" title="Modifier" onclick="editText('b')">✎</button>
            <button type="button" class="rmv" title="Supprimer" onclick="removeText('b')">🗑</button>
          </div>
            </div>
          </div>
          <div class="perso-item" id="pi-logo">
            <button type="button" class="perso-head" onclick="togglePerso('logo')">
              <span class="perso-ico">🖼️</span>
              <span class="perso-txt">
                <span class="perso-name">Ajouter un logo</span>
                <span class="perso-sub">Poitrine droite et/ou cœur</span>
              </span>
              <span class="perso-done">✓</span>
              <span class="perso-caret">›</span>
            </button>
            <div class="perso-body">
          <div class="slvg" style="margin-top:6px">
            <div>
              <label>Poitrine droite</label>
              <div class="uz" id="uz-fr" style="padding:5px 4px;flex-direction:column;gap:3px" onclick="document.getElementById('ufr').click()">
                <div class="uz-ico" style="width:18px;height:18px;margin:0"><svg width="10" height="10" viewBox="0 0 24 24" fill="#999"><path d="M9 16V10H5l7-7 7 7h-4v6H9zm-4 4v-2h14v2H5z"/></svg></div>
                <p style="font-size:8px;text-align:center">Cliquez ou glissez<br><em>PNG, JPG, SVG</em></p>
              </div>
              <div class="uprev" id="pfr"><img id="ifr" src="" alt="" style="height:24px"></div>
              <div class="uprev-lbl" id="lfr">
                <span>Aperçu</span>
                <span class="uprev-actions">
                  <button type="button" class="ctr" onclick="centerLogo('fr')" title="Recentrer le logo dans sa zone">⊹</button>
                  <button type="button" class="rmv" onclick="rmUp('fr')">🗑</button>
                </span>
              </div>
            </div>
            <div>
              <label>Cœur (gauche)</label>
              <div class="uz" id="uz-f" style="padding:5px 4px;flex-direction:column;gap:3px" onclick="document.getElementById('uf').click()">
                <div class="uz-ico" style="width:18px;height:18px;margin:0"><svg width="10" height="10" viewBox="0 0 24 24" fill="#999"><path d="M9 16V10H5l7-7 7 7h-4v6H9zm-4 4v-2h14v2H5z"/></svg></div>
                <p style="font-size:8px;text-align:center">Cliquez ou glissez<br><em>PNG, JPG, SVG</em></p>
              </div>
              <div class="uprev" id="pf"><img id="if" src="" alt="" style="height:24px"></div>
              <div class="uprev-lbl" id="lf">
                <span>Aperçu</span>
                <span class="uprev-actions">
                  <button type="button" class="ctr" onclick="centerLogo('f')" title="Recentrer le logo dans sa zone">⊹</button>
                  <button type="button" class="rmv" onclick="rmUp('f')">🗑</button>
                </span>
              </div>
            </div>
          </div>
            </div>
          </div>
          <div class="perso-item" id="pi-names">
            <button type="button" class="perso-head" onclick="togglePerso('names')">
              <span class="perso-ico">👥</span>
              <span class="perso-txt">
                <span class="perso-name">Ajouter plusieurs surnoms</span>
                <span class="perso-sub">Un nom floqué par personne</span>
              </span>
              <span class="perso-done">✓</span>
              <span class="perso-caret">›</span>
            </button>
            <div class="perso-body">
              <p class="sec-sub" style="margin:0 0 8px">Même design pour tous, une ligne par personne.</p>
              <button type="button" class="txt-add-btn" id="txt-multi-btn" onclick="openGroupOrder()" style="display:none">👥 Ouvrir la liste</button>
            </div>
          </div>
          <div class="perso-item" id="pi-back">
            <button type="button" class="perso-head" onclick="togglePerso('back')">
              <span class="perso-ico">👕</span>
              <span class="perso-txt">
                <span class="perso-name">Ajouter un logo dos</span>
                <span class="perso-sub">Grand format, centré</span>
              </span>
              <span class="perso-done">✓</span>
              <span class="perso-caret">›</span>
            </button>
            <div class="perso-body">
<!-- Dos : pleine largeur, sous les deux emplacements poitrine. -->
          <label style="display:block;margin-top:10px">Dos</label>
          <div class="uz" onclick="document.getElementById('ub').click()">
            <div class="uz-ico"><svg width="12" height="12" viewBox="0 0 24 24" fill="#999"><path d="M9 16V10H5l7-7 7 7h-4v6H9zm-4 4v-2h14v2H5z"/></svg></div>
            <p><strong>Cliquez ou glissez votre logo ici</strong><br>PNG, JPG, SVG (max. 5Mo)</p>
          </div>
          <div class="uprev" id="pb">
            <img id="ib" src="" alt="" style="height:28px">
          </div>
          <div class="uprev-lbl" id="lb">
            <span>Aperçu du logo</span>
            <span class="uprev-actions">
              <button type="button" class="ctr" onclick="centerLogo('b')" title="Recentrer le logo dans sa zone">⊹ Centrer</button>
              <button type="button" class="rmv" onclick="rmUp('b')">🗑 Supprimer</button>
            </span>
          </div>
            </div>
          </div>
          <div class="perso-item" id="pi-sleeve">
            <button type="button" class="perso-head" onclick="togglePerso('sleeve')">
              <span class="perso-ico">🧵</span>
              <span class="perso-txt">
                <span class="perso-name">Logo sur les manches</span>
                <span class="perso-sub">Option supplémentaire</span>
              </span>
              <span class="perso-done">✓</span>
              <span class="perso-caret">›</span>
