              <div class="design-logo for-cote" id="logo-sr-face" data-zone="sr-face" style="display:none; left:42%; top:46%; width:12%;">
                <img src="" alt="Logo manche droite" draggable="false">
                <span class="logo-resize" data-resize="sr-face"></span>
              </div>
            </div>

            <div class="mlbl mlbl-r">
              <span>5 cm</span>
              <div class="mline"></div>
            </div>
          </div>

          <!-- Zoom à droite de l'image, en colonne verticale -->
          <div class="cv-ctrl">
