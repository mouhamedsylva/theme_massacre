            </div>

            <div class="mlbl mlbl-r">
              <span>5 cm</span>
              <div class="mline"></div>
            </div>
          </div>

          <!-- Zoom à droite de l'image, en colonne verticale -->
          <div class="cv-ctrl">
            <button type="button" class="cbtn" onclick="zoom(-10)">
