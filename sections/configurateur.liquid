          <div class="ri-thumb"><img id="rc-img-f" src="" alt="Logo cœur"></div>
          <div class="ri-info">
            <div class="ri-name">Logo cœur</div>
            <div class="ri-ok">✓ Personnalisé</div>
          </div>
        </div>

        <!-- Logo dos row -->
        <div class="ri" id="rc-back" style="display:none">
          <div class="ri-thumb"><img id="rc-img-b" src="" alt="Logo dos"></div>
          <div class="ri-info">
            <div class="ri-name">Logo dos</div>
            <div class="ri-ok">✓ Personnalisé</div>
          </div>
        </div>

        <!-- Manches row -->
        <div class="ri" id="rc-sleeves" style="display:none">
          <div class="ri-thumb">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="#888"><path d="M16 5v2h-3V3H11v4H8V5L3 8v3h2v9h14V11h2V8l-5-3z"/></svg>
          </div>
          <div class="ri-info">
            <div class="ri-name">Manches <span id="rc-sleeves-qty" class="ri-qty"></span></div>
            <div class="ri-ok">✓ Personnalisé</div>
          </div>
          <!-- Supplément : renseigné par updateSleeveSurcharge(). -->
          <div class="ri-extra" id="rc-sleeves-extra"></div>
        </div>
      </div><!-- /rp-items -->

      <!-- QUANTITÉ (textiles) : même principe que les drapeaux. Le prix total
           suit la quantité, et l'ajout au panier utilise cette valeur. -->
      <div class="rp-section" id="rp-qty-textile">
        <div class="rp-qty-section">
          <div class="rp-qty-title">QUANTITÉ</div>
          <div class="rp-qty-subtitle">Minimum de commande : 1 unité</div>
          <div class="rp-qty-controls">
            <button type="button" class="rp-qty-btn" onclick="changeTextileQty(-1)">−</button>
            <input type="number" id="textile-qty-input" class="rp-qty-input"
                   value="1" min="1" onchange="handleTextileQtyInput()">
            <button type="button" class="rp-qty-btn" onclick="changeTextileQty(1)">+</button>
          </div>
        </div>
      </div>

      <div class="rp-price">
        <div class="rp-plbl">Prix Total</div>
        <div class="rp-pval" id="rp-price-val">45,00 € <span class="rp-pvat">TTC</span></div>
      </div>

      <!-- Option payante activée : rappel sous le prix, pour que le supplément
           inclus dans le total soit explicite. Piloté par applySleeveOption(). -->
      <div class="rp-opt-flag" id="rp-sleeve-flag" style="display:none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 6L9 17l-5-5"/>
        </svg>
        <span>Option manches activée <b id="rp-sleeve-amount"></b></span>
      </div>

      <div class="rp-acts">
        <!-- Rappel de la liste de groupe validée : l'ajout au panier créera
             une ligne par personne. Rempli par refreshGroupBadge(). -->
        <!-- Deux actions : le libellé rouvre la liste préremplie, la croix la
             supprime. Rempli par refreshGroupBadge(). -->
        <div id="grp-badge" class="grp-badge" style="display:none"></div>
        <button type="button" class="btn-cart" id="main-add-to-cart" onclick="addToCart()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM2.73 5.15L4 12h12.55c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 21 3H5.21l-.94-2H1v2h2l3.6 7.59z"/></svg>
          Ajouter au panier
        </button>
        <!-- Commande de groupe : le point d'entrée est désormais « Ajouter
             plusieurs noms », dans la section Texte personnalisé. Ce bouton est
             conservé (masqué) : le JS le référence encore pour la logique
             textile, et la modale reste la même. -->
        {% comment %} <button type="button" class="btn-group" id="btn-group-order" onclick="openGroupOrder()" style="display:none">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          Commander pour un groupe
        </button> {% endcomment %}

      </div>

      <div class="rp-trust">
        <div class="ti">
          <div class="ti-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="#666"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg></div>
          <div class="ti-txt">Paiement sécurisé<span>Transactions 100% sécurisées</span></div>
        </div>
        <div class="ti">
          <div class="ti-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="#666"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg></div>
          <div class="ti-txt">Service client<span>À votre écoute 7j/7</span></div>
        </div>
      </div>
    </aside>

    <!-- MODALE : Guide des tailles -->
    <div class="sg-modal-overlay" id="sg-modal-overlay" onclick="if(event.target===this)closeSizeGuide()">
      <div class="sg-modal">
        <div class="sg-modal-head">
          <h3>Guide des tailles</h3>
          <button type="button" class="sg-modal-x" onclick="closeSizeGuide()" title="Fermer">✕</button>
        </div>
        <div class="sg-modal-body">
          <div class="sg-figure">
            <svg viewBox="0 0 120 130" width="110" height="120" fill="none" stroke="#333" stroke-width="2">
              <path d="M40 18 L30 26 L18 38 L26 48 L34 42 L34 112 L86 112 L86 42 L94 48 L102 38 L90 26 L80 18 Q60 30 40 18 Z"/>
              <line x1="46" y1="40" x2="46" y2="60" stroke="#e02424" stroke-width="1.5"/>
              <text x="49" y="54" font-size="12" fill="#e02424" stroke="none" font-weight="700">A</text>
              <line x1="46" y1="70" x2="46" y2="105" stroke="#e02424" stroke-width="1.5"/>
              <text x="49" y="92" font-size="12" fill="#e02424" stroke="none" font-weight="700">B</text>
            </svg>
          </div>
          <div class="sg-table-wrap">
            <table class="sg-table">
              <thead>
                <tr>
                  <th></th><th>XS</th><th>S</th><th>M</th><th>L</th><th>XL</th>
                  <th>XXL</th><th>3XL</th><th>4XL</th><th>5XL</th>
                </tr>
              </thead>
              <tbody>
                <tr><td class="sg-row-lbl">A — Largeur (cm)</td>
                  <td>47</td><td>50</td><td>53</td><td>56</td><td>59</td>
                  <td>62</td><td>65</td><td>70</td><td>75</td></tr>
                <tr><td class="sg-row-lbl">B — Hauteur (cm)</td>
                  <td>68</td><td>70</td><td>72</td><td>74</td><td>76</td>
                  <td>78</td><td>80</td><td>82</td><td>84</td></tr>
              </tbody>
            </table>
          </div>
          <p class="sg-note">Mesures approximatives à plat. A = largeur poitrine, B = longueur du vêtement.</p>
        </div>
      </div>
    </div>

    <!-- MODALE : Commande de groupe (textiles) -->
    <div class="grp-overlay" id="grp-overlay" onclick="if(event.target===this)closeGroupOrder()">
      <div class="grp-modal" role="dialog" aria-label="Commande pour un groupe">
        <div class="grp-head">
          <div>
            <h3>Commande pour un groupe</h3>
            <p class="grp-sub">Même design pour tous. Ajoutez une ligne par personne : taille, couleur et, si besoin, un nom/numéro floqué.</p>
          </div>
          <button type="button" class="grp-x" onclick="closeGroupOrder()" title="Fermer" aria-label="Fermer">✕</button>
        </div>

        <div class="grp-body">
          <!-- Import d'une liste existante : en tête de modale, avant le tableau. -->
          <div class="grp-import-bar">
            <input type="file" id="grp-file" accept=".csv,.txt,.xlsx,.xls"
                   onchange="grpImportFile(this)" hidden>
            <button type="button" class="grp-btn-import" onclick="document.getElementById('grp-file').click()">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><path d="M17 8l-5-5-5 5"/><path d="M12 3v12"/></svg>
              Importer un fichier CSV / Excel
            </button>
            <p class="grp-import-hint" id="grp-import-hint">
              Vous avez déjà la liste ? Importez-la. Colonnes :
              <strong>Nom floqué, Taille, Couleur, Qté</strong>.
            </p>
          </div>

          <div class="grp-table-wrap">
            <table class="grp-table">
              <thead>
                <tr>
                  {% comment %} <th class="grp-c-name">Nom / réf.</th> {% endcomment %}
                  <th class="grp-c-flock">Nom floqué <span class="grp-opt">(option)</span></th>
                  <th class="grp-c-size">Taille</th>
                  <th class="grp-c-color">Couleur</th>
                  <th class="grp-c-qty">Qté</th>
                  <th class="grp-c-act"></th>
                </tr>
              </thead>
              <tbody id="grp-rows"><!-- lignes injectées en JS --></tbody>
            </table>
          </div>

          <button type="button" class="grp-add" onclick="grpAddRow()">＋ Ajouter une ligne</button>

          <div class="grp-summary">
            <span id="grp-total-lines">0 ligne</span>
            <strong id="grp-total-qty">0 pièce</strong>
          </div>

          <p class="grp-note">
            💡 Même design pour tous. En validant, votre liste est enregistrée :
            « Ajouter au panier » créera ensuite <strong>une ligne par personne</strong>
            (taille, couleur et nom floqué propres à chacune).
          </p>
        </div>

        <div class="grp-foot">
          <button type="button" class="grp-btn-secondary" onclick="closeGroupOrder()">Annuler</button>
          <button type="button" class="grp-btn-primary" id="grp-submit" onclick="submitGroupOrder(this)">
            Confirmer
          </button>
        </div>
      </div>
    </div>

    <!-- Aperçu d'une ligne (couleur + design) -->
    <div class="grp-preview-overlay" id="grp-preview-overlay" onclick="if(event.target===this)closeGroupPreview()">
      <div class="grp-preview-box">
        <button type="button" class="grp-x" onclick="closeGroupPreview()" title="Fermer">✕</button>
        <div class="grp-preview-title" id="grp-preview-title">Aperçu</div>
        <div class="grp-preview-stage" id="grp-preview-stage"></div>
      </div>
    </div>

    <!-- NOUVEAU MODAL : Sélection quantités par taille -->
    {% render 'size-quantity-modal' %}

  <script src="{{ 'conf-main-inline.js' | asset_url }}" defer></script>
  </div><!-- /conf-app-root -->

  <!-- ══ VUE D'ENSEMBLE ══ Composée par captureAllViews() : mêmes images que
       la planche de production (voir conf-overview.js). -->
  <div class="ov-overlay" id="ov-overlay" onclick="closeOverview()"></div>
  <div class="ov-modal" id="ov-modal" role="dialog" aria-modal="true" aria-labelledby="ov-title">
    <div class="ov-hdr">
      <div>
        <span class="ov-title" id="ov-title">Vue d'ensemble</span>
        <span class="ov-sub">Votre personnalisation, vue par vue</span>
      </div>
      <button type="button" class="ov-close" onclick="closeOverview()" aria-label="Fermer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="ov-body" id="ov-body"></div>
  </div>

  <!-- ══ CART DRAWER ══ -->
  <div class="cart-overlay" id="cart-overlay" onclick="closeCartDrawer()"></div>
  <div class="cart-drawer" id="cart-drawer">
    <div class="cd-hdr">
      <div>
        <span class="cd-title">Panier</span>
        <span class="cd-count" id="cd-count"></span>
      </div>
      <button type="button" class="cd-close" onclick="closeCartDrawer()" aria-label="Fermer">×</button>
    </div>

    <div class="cd-items" id="cd-items">
      <div class="cd-empty" id="cd-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <p>Votre panier est vide</p>
      </div>
    </div>

    <div class="cd-footer" id="cd-footer" style="display:none">
      <div class="cd-subtotal" id="cd-subtotal">
        <span class="cd-subtotal-lbl">Total estimé</span>
        <span class="cd-subtotal-val" id="cd-total">0,00 €</span>
      </div>
      <p class="cd-tax-note" id="cd-tax-note">Taxes incluses. Livraison calculée à l'étape suivante.</p>
      <button type="button" class="cd-checkout" id="cd-checkout-btn" onclick="goToRecap()">
        Continuer
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
      </button>
    </div>
  </div>


