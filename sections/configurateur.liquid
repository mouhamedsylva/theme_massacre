            Position : à 5 cm de la couture de l'épaule
          </div>
          <div class="slvg" style="margin-top:6px">
            <div>
              <label>Manche gauche</label>
              <div class="uz" style="padding:5px 4px;flex-direction:column;gap:3px" onclick="document.getElementById('usl').click()">
                <div class="uz-ico" style="width:18px;height:18px;margin:0"><svg width="10" height="10" viewBox="0 0 24 24" fill="#999"><path d="M9 16V10H5l7-7 7 7h-4v6H9zm-4 4v-2h14v2H5z"/></svg></div>
                <p style="font-size:8px;text-align:center">Cliquez ou glissez<br><em>PNG, JPG, SVG</em></p>
              </div>
              <div class="uprev" id="psl"><img id="isl" src="" alt="" style="height:24px"></div>
              <div class="uprev-lbl" id="lsl">
                <span>Aperçu</span>
