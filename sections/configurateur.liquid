                      onchange="choisirTailleDepuisRecap(this.value)"></select>
            </label>
            <div class="rp-tq-col">
              <span class="rp-tq-lbl">Qté</span>
              <div class="rp-qty-controls">
                <button type="button" class="rp-qty-btn" onclick="changeTextileQty(-1)">−</button>
                <input type="number" id="textile-qty-input" class="rp-qty-input"
                       value="1" min="1" onchange="handleTextileQtyInput()">
                <button type="button" class="rp-qty-btn" onclick="changeTextileQty(1)">+</button>
              </div>
            </div>
          </div>

          <button type="button" class="rp-multi-btn" onclick="ouvrirRepartitionTailles()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            <span class="rp-multi-txt">Répartir par tailles</span>
            {%- comment -%}
              Chevron : il annonce l'ouverture d'un panneau. Sans lui, rien ne
              distinguait ce bouton d'une action immédiate.
            {%- endcomment -%}
            <svg class="rp-multi-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor"
