{% comment %}
  Snippet: Modal de sélection de quantités par taille
  Usage: {% render 'size-quantity-modal' %}
{% endcomment %}

<!-- MODAL : Sélection de quantités par taille -->
<div class="size-qty-overlay" id="size-qty-overlay" onclick="if(event.target===this)closeSizeQuantityModal()">
  <div class="size-qty-modal" role="dialog" aria-label="Sélectionner les quantités par taille">
    
    <!-- Header -->
    <div class="size-qty-head">
      {%- comment -%}
        Remet toutes les tailles à zéro d'un geste. Sans lui, revenir d'une
        répartition de huit tailles à une seule demandait autant de clics qu'il
        y avait de lignes garnies.
      {%- endcomment -%}
      <button class="size-qty-reset" onclick="resetSizeQuantities()"
              title="Tout remettre à zéro" aria-label="Tout remettre à zéro">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 3-6.7L3 8"/>
          <path d="M3 3v5h5"/>
        </svg>
        Réinitialiser
      </button>
      <button class="size-qty-x" onclick="closeSizeQuantityModal()" title="Fermer" aria-label="Fermer">✕</button>
    </div>

    <!-- Body -->
    <div class="size-qty-body">
      <!-- Liste des tailles avec compteurs +/- -->
      <div class="size-qty-list" id="size-qty-list">
        <!-- Les lignes seront injectées par JavaScript -->
      </div>
    </div>

    <!-- Footer avec boutons d'action -->
    <div class="size-qty-footer">
      <!-- Boutons d'action -->
      <div class="size-qty-actions">
        <button class="size-qty-btn-cancel" onclick="closeSizeQuantityModal()">Annuler</button>
        <button class="size-qty-btn-confirm" onclick="confirmSizeQuantities()">Confirmer</button>
      </div>
    </div>

  </div>
</div>
