        </div>

        <div class="flag-type-card" data-type="recto-simple" onclick="selectFlagType(this)">
          <div class="flag-type-icon">
            <svg width="46" height="40" viewBox="0 0 46 40" fill="none" stroke="currentColor" stroke-width="1.6">
              <line x1="8" y1="6" x2="8" y2="34"/>
              <rect x="8" y="7" width="22" height="15" rx="1"/>
              <path d="M15 12 l3 3 L21 12" stroke-width="1.4"/>
            </svg>
          </div>
          <div class="flag-type-info">
            <strong>Recto simple</strong>
            <span>Impression sublimée sur une seule face.</span>
          </div>
          <div class="flag-type-check">✓</div>
        </div>
      </div>
    </div>

    <!-- 2. Orientation -->
    <div class="panel-section">
      <div class="panel-section-title">Orientation</div>
      <div class="panel-section-subtitle">Choisissez l'orientation de votre drapeau</div>

      <div class="flag-orientation-row">
        <div class="flag-orientation-card active" data-orientation="paysage" onclick="selectFlagOrientation(this)">
          <svg width="64" height="48" viewBox="0 0 64 48" fill="none">
            <line x1="8" y1="6" x2="8" y2="44" stroke="#1a2b4a" stroke-width="2.4" stroke-linecap="round"/>
            <rect x="8" y="9" width="44" height="26" rx="1.5" fill="#1f3a5f" stroke="#1f3a5f" stroke-width="1.5"/>
          </svg>
          <span>Paysage</span>
          <span class="flag-ori-sub">(horizontal)</span>
          <div class="flag-orientation-check">✓</div>
        </div>

        <div class="flag-orientation-card" data-orientation="portrait" onclick="selectFlagOrientation(this)">
          <svg width="48" height="56" viewBox="0 0 48 56" fill="none">
            <line x1="8" y1="4" x2="8" y2="52" stroke="#9aa0aa" stroke-width="2.4" stroke-linecap="round"/>
            <rect x="8" y="7" width="30" height="40" rx="1.5" fill="#fff" stroke="#9aa0aa" stroke-width="1.8"/>
          </svg>
          <span>Portrait</span>
          <span class="flag-ori-sub">(vertical)</span>
          <div class="flag-orientation-check">✓</div>
        </div>
      </div>
    </div>

    <!-- La couleur du fond a migré au-dessus de l'aperçu (barre du canvas,
         construite par loadDrapeauxCanvas dans conf-dynamic-layout.js) :
         on juge une couleur en la regardant, pas depuis un panneau
         qu'il faut faire défiler. -->

    <!-- 3. Taille -->
    <div class="panel-section">
      <div class="panel-section-title">Taille</div>
      <div class="panel-section-subtitle">Choisissez la taille de votre drapeau</div>

      <div class="flag-size-options">
        <div class="flag-size-card active" data-size="90x150" onclick="selectFlagSize(this)">
          <strong>90 x 150 cm</strong>
          <span>Format standard</span>
          <div class="flag-size-check">✓</div>
        </div>
      </div>

      <!-- Note + bouton forment UN bloc : le bouton est l'action de la note
           qui le précède, les séparer casserait ce lien de lecture. -->
      <div class="flag-custom-block">
        <div class="flag-custom-note">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 11v5"/>
            <circle cx="12" cy="7.8" r="0.9" fill="currentColor" stroke="none"/>
          </svg>
          <span>Pour une taille personnalisée, contactez-nous afin de voir ensemble les possibilités.</span>
        </div>

        <button class="flag-contact-btn" onclick="contactForCustomSize()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          CONTACTEZ-NOUS
        </button>
      </div>
    </div>

    <!-- 4. Options de finition -->
    <div class="panel-section">
      <div class="panel-section-title">Options</div>
      <div class="panel-section-subtitle">Personnalisez la finition de votre drapeau</div>

      <div class="flag-options-section">
        <!-- Sans anneaux : finition par défaut (fichiers flag-0an-*.png). -->
        <div class="flag-option-item active" data-anneaux="0" onclick="selectAnneaux(this)">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="4" y="6" width="16" height="12" rx="1.5"/>
          </svg>
          <div>
            <strong>Sans anneaux</strong>
            <span>Bord simple, sans œillet</span>
          </div>
          <div class="flag-option-check">✓</div>
        </div>

        <div class="flag-option-item" data-anneaux="2" onclick="selectAnneaux(this)">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="8" cy="12" r="2.6"/>
            <circle cx="16" cy="12" r="2.6"/>
          </svg>
          <div>
            <strong>2 anneaux</strong>
            <span>Finition par 2 anneaux</span>
          </div>
          <div class="flag-option-check">✓</div>
        </div>

        <div class="flag-option-item" data-anneaux="4" onclick="selectAnneaux(this)">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="7" cy="8" r="2.2"/>
            <circle cx="17" cy="8" r="2.2"/>
            <circle cx="7" cy="16" r="2.2"/>
            <circle cx="17" cy="16" r="2.2"/>
          </svg>
          <div>
            <strong>4 anneaux</strong>
            <span>Finition par 4 anneaux</span>
          </div>
          <div class="flag-option-check">✓</div>
        </div>
      </div>

      <div class="flag-material-section">
        <div class="flag-material-label">Matière</div>
        <div class="flag-material-card active">
          <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="16" r="13" fill="#e9ebee" stroke="#c2c7cf" stroke-width="1.5"/>
            <path d="M8 12h16M8 16h16M8 20h16" stroke="#b3b9c2" stroke-width="1.3"/>
            <path d="M12 8v16M16 8v16M20 8v16" stroke="#b3b9c2" stroke-width="1.3"/>
          </svg>
          <div>
            <strong>Maille polyester 110g/m²</strong>
            <span>Tissu léger, parfait pour usage intérieur et extérieur</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</aside>

<!-- ════════════════════════════════════════════════════════════════
     PANNEAU : OPTIONS DU PATCH
     Reprend les réglages de l'ancien COINS_SIDEBAR_TEMPLATE
     (conf-dynamic-layout.js) au design du sidebar moderne. Les
     fonctions appelées (selectShape, selectCoinSize, selectFabrication)
     sont inchangées.
     ════════════════════════════════════════════════════════════════ -->
<aside class="side-panel" id="panel-patch">
  <div class="side-panel-header">
    <div class="side-panel-header-content">
      <h2 class="side-panel-title">OPTIONS DU PATCH</h2>
      <p class="side-panel-subtitle">Personnalisez votre patch</p>
    </div>
  </div>

  <div class="side-panel-content">

    <!-- 1. Forme -->
    <div class="panel-section">
      <div class="panel-section-title">Forme</div>
      <div class="panel-section-subtitle">Choisissez la forme de votre patch</div>

      <div class="coins-shape-row">
        <div class="coins-shape-card active" data-shape="rond" onclick="selectShape(this)">
          <svg viewBox="0 0 50 50" width="36" height="36">
            <circle cx="25" cy="25" r="22" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span>Rond</span>
          <div class="coins-shape-check">✓</div>
        </div>
        <div class="coins-shape-card" data-shape="carre" onclick="selectShape(this)">
          <svg viewBox="0 0 50 50" width="36" height="36">
            <rect x="3" y="3" width="44" height="44" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span>Carré</span>
          <div class="coins-shape-check">✓</div>
        </div>
        <div class="coins-shape-card" data-shape="rectangle" onclick="selectShape(this)">
          <svg viewBox="0 0 50 50" width="36" height="36">
            <rect x="3" y="12" width="44" height="26" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span>Rectangle</span>
          <div class="coins-shape-check">✓</div>
        </div>
        <div class="coins-shape-card" data-shape="blason" onclick="selectShape(this)">
          <svg viewBox="0 0 50 50" width="36" height="36">
            <path d="M25 3 L46 9 L46 22 Q46 35 25 47 Q4 35 4 22 L4 9 Z" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span>Blason</span>
          <div class="coins-shape-check">✓</div>
        </div>
      </div>
    </div>

    <!-- 2. Taille -->
    <div class="panel-section">
      <div class="panel-section-title">Taille</div>
      <div class="panel-section-subtitle">Sélectionnez la taille de votre patch</div>

      <div class="coins-size-grid">
        <div class="coins-size-card circle" data-size="6cm" onclick="selectCoinSize(this)">
          <div class="coins-size-shape"></div>
          <p>6 cm</p>
        </div>
        <div class="coins-size-card circle" data-size="7cm" onclick="selectCoinSize(this)">
          <div class="coins-size-shape"></div>
          <p>7 cm</p>
        </div>
        <div class="coins-size-card circle active" data-size="8cm" onclick="selectCoinSize(this)">
          <div class="coins-size-shape"></div>
          <p>8 cm</p>
          <div class="coins-size-check">✓</div>
        </div>
        <div class="coins-size-card circle" data-size="9cm" onclick="selectCoinSize(this)">
          <div class="coins-size-shape"></div>
          <p>9 cm</p>
        </div>
        <div class="coins-size-card circle" data-size="10cm" onclick="selectCoinSize(this)">
          <div class="coins-size-shape"></div>
          <p>10 cm</p>
        </div>
        <div class="coins-size-card rect" data-size="8x6cm" onclick="selectCoinSize(this)">
          <p>8 x 6 cm</p>
          <div class="coins-size-shape"></div>
        </div>
        <div class="coins-size-card rect" data-size="10x7.5cm" onclick="selectCoinSize(this)">
          <p>10 x 7.5 cm</p>
          <div class="coins-size-shape"></div>
        </div>
      </div>
      <p class="coins-size-note">Les dimensions indiquées sont approximatives</p>
    </div>

    <!-- 3. Options de fabrication -->
    <div class="panel-section">
      <div class="panel-section-title">Options de fabrication</div>
      <div class="panel-section-subtitle">Choisissez le type de patch</div>

      <div class="conf-fabrication-options">
        <div class="conf-fabrication-option active" data-fabrication="sublime" onclick="selectFabrication(this)">
          <input type="radio" name="fabrication" id="fab-sublime" checked>
          <label for="fab-sublime">
            <div class="fab-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 22C6.49 22 2 17.51 2 12S6.49 2 12 2s10 4.04 10 9c0 3.31-2.69 6-6 6h-1.77c-.28 0-.5.22-.5.5 0 .12.05.23.13.33.41.47.64 1.06.64 1.67 0 1.38-1.12 2.5-2.5 2.5zm0-18c-4.41 0-8 3.59-8 8s3.59 8 8 8c.28 0 .5-.22.5-.5 0-.16-.08-.28-.14-.35-.41-.46-.63-1.05-.63-1.65 0-1.38 1.12-2.5 2.5-2.5H16c2.21 0 4-1.79 4-4 0-3.86-3.59-7-8-7z"/>
                <circle cx="6.5" cy="11.5" r="1.5"/>
                <circle cx="9.5" cy="7.5" r="1.5"/>
                <circle cx="14.5" cy="7.5" r="1.5"/>
                <circle cx="17.5" cy="11.5" r="1.5"/>
              </svg>
            </div>
            <div class="fab-info">
              <strong>Sublimé</strong>
              <span>Impression de haute qualité aux couleurs éclatantes</span>
            </div>
            <div class="fab-check">✓</div>
          </label>
        </div>

        <!-- PVC et Tissé : sur devis, d'où l'état désactivé et le bouton
             de contact juste en dessous. -->
        <div class="conf-fabrication-option disabled" data-fabrication="pvc">
          <input type="radio" name="fabrication" id="fab-pvc" disabled>
          <label for="fab-pvc">
            <div class="fab-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"/>
                <path d="M7 10h2v7H7zm4-3h2v10h-2zm4 6h2v4h-2z"/>
              </svg>
            </div>
            <div class="fab-info">
              <strong>PVC</strong>
              <span>Patch en PVC souple et résistant. Contactez-nous en envoyant votre design.</span>
            </div>
            <div class="fab-check">✓</div>
          </label>
        </div>

        <div class="conf-fabrication-option disabled" data-fabrication="tissu">
          <input type="radio" name="fabrication" id="fab-tissu" disabled>
          <label for="fab-tissu">
            <div class="fab-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23 5.5V20c0 .55-.45 1-1 1h-1.5v-2h-2v2h-2v-2h-2v2h-2v-2h-2v2h-2v-2h-2v2H3c-.55 0-1-.45-1-1V5.5C2 4.12 3.12 3 4.5 3S7 4.12 7 5.5h2c0-1.38 1.12-2.5 2.5-2.5S14 4.12 14 5.5h2c0-1.38 1.12-2.5 2.5-2.5S21 4.12 21 5.5h2z"/>
                <circle cx="9" cy="13" r="1"/>
                <circle cx="15" cy="13" r="1"/>
                <circle cx="12" cy="10" r="1"/>
                <circle cx="12" cy="16" r="1"/>
              </svg>
            </div>
            <div class="fab-info">
              <strong>Tissé</strong>
              <span>Finition tissée fine et détaillée. Contactez-nous en envoyant votre design.</span>
            </div>
            <div class="fab-check">✓</div>
          </label>
        </div>
      </div>

      <button class="conf-contact-btn" onclick="contactPatchStyle()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        <div>
          <strong>CONTACTEZ-NOUS POUR</strong>
          <span>PVC OU TISSÉ</span>
        </div>
      </button>

      <div class="conf-help-section">
        <div class="conf-help-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#666">
            <path d="M12 1c-4.97 0-9 4.03-9 9v7c0 1.1.9 2 2 2h1v-8H5c0-3.87 3.13-7 7-7s7 3.13 7 7h-1v8h1c1.1 0 2-.9 2-2v-7c0-4.97-4.03-9-9-9z"/>
          </svg>
        </div>
        <div class="conf-help-text">
          <strong>Besoin d'aide ?</strong>
          <p>Contactez-nous, nous sommes là pour vous accompagner.</p>
        </div>
      </div>
    </div>

  </div>
</aside>

<!-- PANNEAU : TEXTE -->
<aside class="side-panel" id="panel-text">
  <div class="side-panel-header">
    <div class="side-panel-header-content">
      <h2 class="side-panel-title">AJOUTER DU TEXTE</h2>
      <p class="side-panel-subtitle">Texte personnalisé</p>
    </div>
  </div>
  
  <div class="side-panel-content">
    <div class="panel-section">

      <!-- Rappel de navigation, même style que le panneau Upload : le texte
           s'ajoute sur la vue affichée, il faut donc basculer soi-même.
           Le libellé est réécrit selon la vue par modernSidebar.refreshTextForm(). -->
      <div class="upload-view-info" id="mtxt-view-info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <p id="mtxt-view-info-text">
          Pour ajouter du texte au dos, basculez vers la <strong>Vue de dos</strong> dans le canvas
        </p>
      </div>

      <!-- Saisie directe, façon CustomInk : un champ + un bouton, sans étape
           intermédiaire. L'emplacement est choisi juste en dessous ; le texte
           est ensuite clampé dans la zone pointillée par conf-text-editor.js. -->
      <input
        type="text"
        id="mtxt-input"
        class="mtxt-input"
        maxlength="40"
        placeholder="Saisissez votre texte ici"
        autocomplete="off"
        oninput="modernSidebar.refreshTextForm()"
        onkeydown="if (event.key === 'Enter') { event.preventDefault(); modernSidebar.addTextToDesign(); }">

      <!-- Emplacement. Côtés nommés du point de vue du PORTEUR, comme les
           manches et le panneau Upload : « gauche » = son cœur. -->
      {% comment %} <div class="mtxt-where-label">Emplacement</div>
      <div class="mtxt-where" id="mtxt-where">
        <button type="button" class="mtxt-where-opt on" data-zone="f"
                onclick="modernSidebar.setTextPlacement(this)"
                title="Poitrine, côté cœur (gauche du porteur)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M8 3l4 2 4-2 4 3-2 4h-2v11H8V10H6L4 6z"/>
            <rect x="8.5" y="9.5" width="4" height="3" rx="0.5" fill="currentColor" stroke="none"/>
          </svg>
          <span>Poitrine gauche</span>
        </button>
        <button type="button" class="mtxt-where-opt" data-zone="fr"
                onclick="modernSidebar.setTextPlacement(this)"
                title="Poitrine, côté droit du porteur">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M8 3l4 2 4-2 4 3-2 4h-2v11H8V10H6L4 6z"/>
            <rect x="11.5" y="9.5" width="4" height="3" rx="0.5" fill="currentColor" stroke="none"/>
          </svg>
          <span>Poitrine droite</span>
        </button>
      </div> {% endcomment %}

      <!-- Bouton principal. Désactivé tant que le champ est vide : cliquer
           sans texte n'a rien à insérer. -->
      <button type="button" class="mtxt-add-btn" id="mtxt-add-btn" disabled
              onclick="modernSidebar.addTextToDesign()">
        Ajouter au design
      </button>

      <p class="mtxt-hint" id="mtxt-hint">
        Le texte reste dans la zone pointillée et pourra être déplacé et mis en forme
        une fois ajouté.
      </p>

      {%- comment -%}
        Le bouton « Ajouter plusieurs surnoms » a été RETIRÉ, avec son
        séparateur « ou » qui n'annonçait plus rien.

        Il basculait en mode groupe sans passer par l'écran de choix : c'était
        le seul chemin où le design devait être conservé plutôt que permuté —
        une exception permanente à maintenir. Le mode groupe se prend
        désormais par l'écran de choix, qui range et ressort le design.
      {%- endcomment -%}

    </div>
  </div>
</aside>
