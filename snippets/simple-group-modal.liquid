{% comment %}
  Snippet: Modal Commande Groupe Simplifié
  Usage: {% render 'simple-group-modal' %}
{% endcomment %}

<!-- MODAL : Commande Groupe Simplifiée -->
<div class="simple-grp-overlay" id="simple-grp-overlay" onclick="if(event.target===this)closeSimpleGroupModal()">
  <div class="simple-grp-modal" role="dialog" aria-label="Commande pour un groupe">
    <div class="simple-grp-head">
      <div>
        <h3>Commande pour un groupe</h3>
        <p class="simple-grp-sub">Même design pour tous. Ajoutez une ligne par personne : taille, couleur et, si besoin, un nom/numéro floqué.</p>
      </div>
      <button class="simple-grp-x" onclick="closeSimpleGroupModal()" title="Fermer" aria-label="Fermer">✕</button>
    </div>

    <div class="simple-grp-body">
      <!-- Bouton d'import -->
      <div class="simple-grp-import">
        <input type="file" id="simple-grp-file" accept=".csv,.txt,.xlsx,.xls" onchange="simpleGrpImportFile(this)" hidden>
        <button class="simple-grp-btn-import" onclick="document.getElementById('simple-grp-file').click()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
            <path d="M17 8l-5-5-5 5"/>
            <path d="M12 3v12"/>
          </svg>
          Importer un fichier CSV / Excel
        </button>
        <p class="simple-grp-hint">Vous avez déjà la liste ? Importez-la. Colonnes : <strong>Nom floqué, Taille, Couleur, Qté</strong>.</p>
      </div>

      <!-- Tableau simplifié -->
      <div class="simple-grp-table-wrap">
        <table class="simple-grp-table">
          <thead>
            <tr>
              <th>NOM FLOQUÉ <span style="font-weight: 400; color: #999;">(option)</span></th>
              <th>TAILLE</th>
              <th>COULEUR</th>
              <th>QTÉ</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="simple-grp-rows"></tbody>
        </table>
      </div>

      <!-- Bouton ajouter ligne -->
      <button class="simple-grp-add" onclick="simpleGrpAddRow()">+ Ajouter une ligne</button>

      <!-- Total -->
      <div class="simple-grp-summary">
        <span id="simple-grp-total-lines">0 ligne</span>
        <strong id="simple-grp-total-qty">0 pièces</strong>
      </div>

      <!-- Note -->
      <div class="simple-grp-note">
        💡 Même design pour tous. En validant, votre liste est enregistrée : « Ajouter au panier » créera ensuite <strong>une ligne par personne</strong> (taille, couleur et nom floqué propres à chacune).
      </div>
    </div>

    <div class="simple-grp-foot">
      <button class="simple-grp-btn-cancel" onclick="closeSimpleGroupModal()">Annuler</button>
      <button class="simple-grp-btn-confirm" onclick="confirmSimpleGroupModal()">Confirmer</button>
    </div>
  </div>
</div>
